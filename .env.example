# Telegram Bot Token (from @BotFather)
TELEGRAM_KEY=your_telegram_bot_token_here

# OpenRouter API Key (optional, for alternative LLM providers)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Maps API Key (for location-based capabilities)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Cloud API Key (for STT/TTS and search capabilities)
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# OpenWeatherMap API Key (for weather capability)
WEATHER_API_KEY=your_weather_api_key_here

# Brave Search API Key (optional, for brave_search/web_search provider)
BRAVE_API_KEY=your_brave_api_key_here

# Google Gemini API Key (Main LLM provider)
GEMINI_API_KEY=your_gemini_api_key_here
# Secrets vault master key. Prefer the *_FILE option in production.
SECRET_VAULT_MASTER_KEY=
SECRET_VAULT_MASTER_KEY_FILE=

# Secret management API access key (non-web automation).
# Accepts header X-Secret-Management-Key.
SECRET_MANAGEMENT_KEY=
