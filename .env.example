# Telegram Bot Token (from @BotFather)
TELEGRAM_KEY=your_telegram_bot_token_here

# OpenRouter API Key (optional, for alternative LLM providers)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Maps API Key (for location-based skills)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Cloud API Key (for STT/TTS and search skills)
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# OpenWeatherMap API Key (for weather skill)
WEATHER_API_KEY=your_weather_api_key_here

# Google Gemini API Key (Main LLM provider)
GEMINI_API_KEY=your_gemini_api_key_here
# Required to encrypt persisted external OAuth tokens.
# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EXTERNAL_ACCOUNTS_ENCRYPTION_KEY=

# Google auth source for Google-based skills:
# - linked_account: requires connected OAuth account
# - api_key: force API key mode
# - auto: prefer linked account, fallback to API key
AOSD_GOOGLE_AUTH_SOURCE=auto
