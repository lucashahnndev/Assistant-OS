{
    "logging": {
        "level": "INFO",
        "separate_files": true,
        "services": {
            "llm": "DEBUG",
            "telegram": "INFO",
            "web": "INFO",
            "api": "INFO",
            "skills": "INFO",
            "interface": "INFO"
        }
    },
    "playback": {
        "enabled": true,
        "persist": true,
        "ttl_hours": 24,
        "max_total_mb": 512,
        "persist_on_success": true,
        "persist_on_error": true
    },
    "interfaces": {
        "voice": {
            "enabled": false,
            "wake_word": "atlas"
        },
        "telegram": {
            "enabled": true,
            "token": "ENV_TELEGRAM_KEY",
            "allowed_users": []
        },
        "server": {
            "enabled": true,
            "host": "0.0.0.0",
            "port": 8000,
            "cors_origins": [
                "http://localhost:5173",
                "http://127.0.0.1:5173",
                "http://192.168.0.9:5173",
                ""
            ]
        }
    },
    "frontend": {
        "host": "localhost",
        "port": 5173,
        "public_mode": true
    },
    "cortex": {
        "chat": {
            "provider": "openrouter",
            "providers": {
                "google": {
                    "api_key": "ENV_GEMINI_API_KEY",
                    "model": "gemini-2.0-flash"
                },
                "openrouter": {
                    "api_key": "ENV_OPENROUTER_API_KEY",
                    "model": "arcee-ai/trinity-large-preview:free"
                },
                "openai": {
                    "api_key": "ENV_OPENAI_API_KEY",
                    "organization_id": "ENV_OPENAI_ORG_ID",
                    "model": "gpt-4o-mini"
                },
                "ollama": {
                    "model": "llama3",
                    "url": "http://localhost:11434/api/chat"
                }
            }
        },
        "vision": {
            "provider": "openrouter",
            "providers": {
                "google": {
                    "api_key": "ENV_GEMINI_API_KEY",
                    "model": "gemini-2.0-flash-lite"
                },
                "openrouter": {
                    "api_key": "ENV_OPENROUTER_API_KEY",
                    "model": "qwen/qwen3-vl-235b-a22b-thinking"
                }
            }
        },
        "audio": {
            "stt": {
                "provider": "google",
                "providers": {
                    "google": {
                        "language": "pt-BR"
                    },
                    "vosk": {
                        "model_path": "model/vosk-model-small-pt-0.3"
                    },
                    "openai": {
                        "api_key": "ENV_OPENAI_API_KEY",
                        "organization_id": "ENV_OPENAI_ORG_ID"
                    }
                }
            },
            "tts": {
                "provider": "edge_tts",
                "providers": {
                    "system": {
                        "rate": 150,
                        "volume": 1
                    },
                    "google_cloud": {
                        "api_key": "ENV_GOOGLE_CLOUD_API_KEY"
                    },
                    "edge_tts": {
                        "voice": "pt-BR-FranciscaNeural"
                    }
                }
            }
        }
    },
    "agent": {
        "agent_name": "Atlas",
        "personality": "Voc\u00ea \u00e9 um assistente proativo, t\u00e9cnico e focado em resolver problemas com precis\u00e3o. Sua comunica\u00e7\u00e3o \u00e9 clara, amig\u00e1vel e profissional."
    },
    "location": {
        "mode": "auto",
        "default": {
            "city": "Canoas",
            "state": "RS",
            "country": "Brazil",
            "lat": "-29.928474",
            "lon": "-51.190630"
        }
    },
    "intent_resolution": {
        "mode": "llm_first",
        "semantic_fallback": true,
        "semantic_first_threshold": 0.92,
        "llm_confidence_threshold": 0.65
    },
    "skills": {
        "system_logs": {
            "enabled": true
        },
        "vision": {
            "enabled": true
        },
        "browser_automator": {
            "enabled": true,
            "profilePath": "data/browser/profile",
            "headless": false,
            "cdp_url": null,
            "viewport": {
                "width": 1280,
                "height": 720
            },
            "timeoutMs": 30000
        },
        "spotify_search": {
            "enabled": false,
            "auth": {
                "clientId": "ENV_SPOTIFY_CLIENT_ID",
                "client_secret": "ENV_SPOTIFY_CLIENT_SECRET"
            },
            "defaults": {
                "market": "BR",
                "limit": 5
            }
        },
        "deezer_search": {
            "enabled": true,
            "api": {
                "baseUrl": "https://api.deezer.com"
            },
            "defaults": {
                "limit": 5
            }
        },
        "youtube_search": {
            "enabled": true,
            "apiKey": "ENV_GOOGLE_CLOUD_API_KEY",
            "defaults": {
                "surfaceMode": "auto",
                "limit": 5
            }
        },
        "maps_search": {
            "enabled": true,
            "apiKey": "ENV_GOOGLE_MAPS_API_KEY",
            "defaults": {
                "region": "BR",
                "language": "pt-BR"
            }
        },
        "web_search": {
            "enabled": true,
            "provider": "duckduckgo"
        },
        "system_control": {
            "enabled": true
        },
        "task_management": {
            "enabled": true
        },
        "memory_management": {
            "enabled": true
        },
        "weather_control": {
            "enabled": true,
            "api_key": "ENV_WEATHER_API_KEY"
        },
        "system_apps": {
            "enabled": true
        },
        "shell_control": {
            "enabled": true
        },
        "reflex_skill": {
            "enabled": true
        }
    }
}