{
    "logging": {
        "level": "INFO",
        "separate_files": true,
        "console_colors": true,
        "services": {
            "llm": "DEBUG",
            "telegram": "INFO",
            "web": "INFO",
            "api": "INFO",
            "capabilities": "INFO",
            "interface": "INFO"
        }
    },
    "playback": {
        "enabled": true,
        "persist": true,
        "ttl_hours": 24,
        "max_total_mb": 512,
        "persist_on_success": true,
        "persist_on_error": true
    },
    "runtime": {
        "agent_runtime_v2_enabled": false,
        "agent_runtime_v2": {
            "policy_mode": "log_only",
            "runtime_version": "runtime_v2",
            "planner_version": "planner_v2",
            "policy_version": "policy_v1",
            "policy": {
                "mode": "log_only",
                "deny_actions": [],
                "require_approval_risk_levels": [
                    "critical"
                ],
                "allow_with_constraints_risk_levels": [
                    "high"
                ],
                "require_approval_actions": [],
                "allow_with_constraints_qos": [
                    "LOW"
                ]
            },
            "governance": {
                "rate_limit": {
                    "window_seconds": 60,
                    "max_actions_per_minute_per_agent": 60,
                    "max_actions_per_minute_per_tenant": 300,
                    "max_parallel_actions_per_agent": 2
                },
                "cost_budget": {
                    "max_actions_per_goal": 120,
                    "max_mcp_calls_per_step": 15,
                    "max_actions_per_tenant_window": 1200
                }
            },
            "sandbox": {
                "force_for_all": false,
                "tenant_ids": [],
                "default_profile_id": "sandbox-default",
                "profile_by_tenant": {},
                "allow_effect_actions": []
            },
            "policy_simulation": {
                "enabled": true,
                "max_replay_events": 500
            },
            "policy_rollout": {
                "enabled": true,
                "max_error_rate": 0.2,
                "max_latency_increase": 0.5
            },
            "observability": {
                "enabled": true,
                "event_log": "runtime_v2/governance_events.jsonl",
                "replay_payload_enabled": true
            }
        }
    },
    "interfaces": {
        "voice": {
            "enabled": false,
            "wake_word": "atlas",
            "sanitize_tts_text": true,
            "vad_threshold": 300,
            "endpoint_silence_chunks": 2,
            "endpoint_silence_ms": 900,
            "vad_assistant_multiplier": 2.0,
            "debug_vad": false,
            "debug_vad_every_chunks": 20,
            "partial_stt_enabled": true,
            "partial_stt_interval_ms": 900,
            "partial_stt_min_buffer_ms": 500,
            "partial_stt_window_ms": 3500,
            "partial_stt_min_chars": 4
        },
        "telegram": {
            "enabled": true,
            "secret_ref": "ENV_TELEGRAM_KEY",
            "allowed_users": []
        },
        "server": {
            "enabled": true,
            "host": "0.0.0.0",
            "port": 8000,
            "tls": {
                "enabled": true,
                "certfile": "data/certs/localhost.crt",
                "keyfile": "data/certs/localhost.key"
            },
            "cors_origins": [
                "http://localhost:5173",
                "http://127.0.0.1:5173",
                "https://localhost:5173",
                "https://127.0.0.1:5173",
                "http://192.168.0.9:5173",
                ""
            ]
        }
    },
    "frontend": {
        "host": "localhost",
        "port": 5173,
        "public_mode": true
    },
    "chat": {
        "cards_enabled": false
    },
    "i18n": {
        "default_locale": "en",
        "supported_locales": [
            "en",
            "pt-BR"
        ],
        "fallback_locale": "en"
    },
    "conversation_coaching": {
        "enabled": true,
        "max_response_chars_for_followup": 1200,
        "tone": "consultative"
    },
    "approval_notifications": {
        "idle_notify_after_sec": 120,
        "digest_cooldown_sec": 120
    },
    "permission_controls": {
        "approval_decisions": {
            "enabled": true,
            "allowed_interfaces": [
                "*"
            ],
            "denied_interfaces": [],
            "allowed_groups": [
                "*"
            ],
            "denied_groups": []
        }
    },
    "planner": {
        "policy": {
            "max_retries_per_step": 2,
            "retry_on": [
                "TIMEOUT",
                "BROWSER_CLOSED"
            ],
            "abort_on": [
                "NAVIGATION_ERROR",
                "MISSING_TARGET"
            ],
            "retry_http_status": {
                "500": 1,
                "503": 2
            },
            "abort_http_status": {
                "404": true,
                "401": true
            },
            "max_total_steps": 20
        }
    },
    "decision_policy": {
        "media_override_mode": "hard"
    },
    "browser.control": {
        "engine": "playwright_headless",
        "headless": false,
        "goto_retries": 3,
        "goto_timeout_ms": 30000,
        "step_timeout_ms": {
            "go": 30000,
            "ck": 10000,
            "tp": 10000,
            "ss": 5000,
            "perceive": 10000
        }
    },
    "memory": {
        "consolidation_threshold_tokens": 1600,
        "toon_delta_max_entries": 8,
        "toon_delta_text_limit": 96
    },
    "work_execution": {
        "preempt_on_new_input": false,
        "default_scope": "global"
    },
    "work_feedback": {
        "progress_updates_enabled": false,
        "progress_update_every_loops": 6,
        "progress_min_interval_sec": 12,
        "max_progress_notes": 4
    },
    "cortex": {
        "chat": {
            "provider": "openrouter",
            "providers": {
                "google": {
                    "secret_ref": "ENV_GEMINI_API_KEY",
                    "model": "gemini-2.0-flash"
                },
                "openrouter": {
                    "secret_ref": "ENV_OPENROUTER_API_KEY",
                    "model": "arcee-ai/trinity-large-preview:free",
                    "timeout": 30
                },
                "openai": {
                    "secret_ref": "ENV_OPENAI_API_KEY",
                    "organization_id": "ENV_OPENAI_ORG_ID",
                    "model": "gpt-4o-mini"
                },
                "huggingface": {
                    "secret_ref": "ENV_HUGGINGFACE_API_KEY",
                    "model": "HuggingFaceTB/SmolLM3-3B",
                    "base_url": "https://router.huggingface.co/v1",
                    "timeout": 90,
                    "max_tokens": 512
                },
                "ollama": {
                    "model": "llama3",
                    "url": "http://localhost:11434/api/chat"
                }
            }
        },
        "vision": {
            "provider": "openrouter",
            "providers": {
                "google": {
                    "secret_ref": "ENV_GEMINI_API_KEY",
                    "model": "gemini-2.0-flash-lite"
                },
                "openrouter": {
                    "secret_ref": "ENV_OPENROUTER_API_KEY",
                    "model": "qwen/qwen3-vl-235b-a22b-thinking"
                },
                "huggingface": {
                    "secret_ref": "ENV_HUGGINGFACE_API_KEY",
                    "model": "Qwen/Qwen2.5-VL-7B-Instruct",
                    "base_url": "https://router.huggingface.co/v1",
                    "timeout": 90,
                    "max_tokens": 512
                }
            }
        },
        "audio": {
            "stt": {
                "provider": "google",
                "providers": {
                    "google": {
                        "language": "pt-BR"
                    },
                    "vosk": {
                        "model_path": "model/vosk-model-small-pt-0.3"
                    },
                    "openai": {
                        "secret_ref": "ENV_OPENAI_API_KEY",
                        "organization_id": "ENV_OPENAI_ORG_ID"
                    }
                }
            },
            "tts": {
                "provider": "edge_tts",
                "providers": {
                    "system": {
                        "preferred_gender": "MALE",
                        "rate": 150,
                        "volume": 1
                    },
                    "google_cloud": {
                        "secret_ref": "ENV_GOOGLE_CLOUD_API_KEY"
                    },
                    "edge_tts": {
                        "voice": "pt-BR-FranciscaNeural"
                    }
                }
            }
        }
    },
    "agent": {
        "agent_name": "Atlas",
        "spoken_name": "",
        "personality": "You are a proactive, technical assistant focused on solving problems with precision. Your communication is clear, friendly, and professional.",
        "personality_scope": "response_text_only"
    },
    "location": {
        "mode": "auto",
        "default": {
            "city": "Canoas",
            "state": "RS",
            "country": "Brazil",
            "timezone": "America/Sao_Paulo",
            "language": "pt-BR",
            "lat": "-29.928474",
            "lon": "-51.190630"
        }
    },
    "prompt_context": {
        "actions_mode": "on_demand",
        "actions_pack_style": "compact_json",
        "focus_limit": 8,
        "instruction_pack_style": "compact_json",
        "personality_max_chars": 220,
        "toon_deltas_mode": "adaptive",
        "specialist_prompt_mode": "ultra_compact",
        "specialist_prompt_max_chars": 320,
        "observation_result_max_chars": 900,
        "observation_summarize_threshold_chars": 1800
    },
    "capabilities": {
        "system_logs": {
            "enabled": true
        },
        "vision": {
            "enabled": true
        },
        "assistive_overlay": {
            "enabled": true,
            "backend": "qt",
            "default_ttl_ms": 4500,
            "allow_wayland": false
        },
        "browser_control": {
            "enabled": true,
            "headless": false,
            "runtime_backend": "playwright",
            "playwright_transport_mode": "mcp",
            "playwright_mcp_endpoint": "http://127.0.0.1:8787",
            "playwright_mcp_fallback_to_local": false,
            "require_delegated_executor_for_browser_launch": true,
            "run_failure_cooldown_seconds": 45,
            "max_new_tabs_per_session": 3,
            "browser_engine_preference": "managed_chromium",
            "chrome_path": "",
            "managed_chromium_path": "data/browser_bin/chromium/current/chrome",
            "profile_split_by_engine": true,
            "extension_install_mode": "auto",
            "extension_fallback_enabled": true,
            "registry_enabled": true,
            "policy_enabled": true,
            "media_singleton_enforced": true,
            "app_mode_enabled": true,
            "registry_gc_enabled": false,
            "registry_gc_idle_seconds": 1800
        },
        "spotify_search": {
            "enabled": false,
            "auth": {
                "client_id": "ENV_SPOTIFY_CLIENT_ID",
                "client_secret": "ENV_SPOTIFY_CLIENT_SECRET"
            },
            "defaults": {
                "market": "BR",
                "limit": 5
            }
        },
        "deezer_search": {
            "enabled": true,
            "api": {
                "baseUrl": "https://api.deezer.com"
            },
            "defaults": {
                "limit": 5
            }
        },
        "youtube": {
            "enabled": true,
            "authSource": "auto",
            "apiKey": "ENV_GOOGLE_CLOUD_API_KEY",
            "search": {
                "defaults": {
                    "surfaceMode": "auto",
                    "limit": 5
                }
            },
            "retrieve": {
                "defaults": {
                    "include_transcript": false,
                    "max_chars": 12000
                }
            }
        },
        "maps_search": {
            "enabled": true,
            "apiKey": "ENV_GOOGLE_MAPS_API_KEY",
            "defaults": {
                "region": "BR",
                "language": "en-US"
            }
        },
        "web": {
            "enabled": true,
            "search": {
                "defaults": {
                    "limit": 5,
                    "mode": "links",
                    "language": "en",
                    "timeout_ms": 5000,
                    "retries": 1
                },
                "search_router": {
                    "inherit_provider_capabilities": true,
                    "provider_order": [
                        "searxng",
                        "brave",
                        "ddg",
                        "openalex",
                        "commoncrawl"
                    ],
                    "providers": {}
                }
            },
            "retrieve": {
                "defaults": {
                    "timeout_ms": 10000,
                    "retries": 1,
                    "max_chars": 12000
                }
            }
        },
        "brave_search": {
            "enabled": true,
            "provider": {
                "enabled": false,
                "api_key": "ENV_BRAVE_API_KEY"
            }
        },
        "ddg_search": {
            "enabled": true,
            "provider": {
                "enabled": false
            }
        },
        "searxng_search": {
            "enabled": true,
            "provider": {
                "enabled": true,
                "endpoints": [
                    "https://searx.be",
                    "https://search.inetol.net"
                ]
            }
        },
        "openalex_search": {
            "enabled": true,
            "provider": {
                "enabled": true
            }
        },
        "commoncrawl_search": {
            "enabled": true,
            "provider": {
                "enabled": true,
                "collinfo_url": "https://index.commoncrawl.org/collinfo.json",
                "max_indexes": 2
            }
        },
        "research_retrieve": {
            "enabled": true,
            "use_external_rag_runtime": true,
            "defaults": {
                "execution": {
                    "max_docs": 3,
                    "max_total_chars": 14000,
                    "latency_budget_ms": 12000
                },
                "provider_limits": {
                    "max_providers": 2,
                    "max_fallback_depth": 2,
                    "prefer_modular_providers": true
                },
                "control_plane": {
                    "overrides": {},
                    "scorecard": {}
                }
            }
        },
        "system_control": {
            "enabled": true
        },
        "task_management": {
            "enabled": true
        },
        "calendar": {
            "enabled": true,
            "retention_days": 730,
            "title_max_length": 72,
            "description_max_length": 4000,
            "short_id_length": 10
        },
        "notifications": {
            "enabled": true
        },
        "memory_management": {
            "enabled": true
        },
        "weather_control": {
            "enabled": true,
            "api_key": "ENV_WEATHER_API_KEY"
        },
        "data_analysis": {
            "enabled": true,
            "defaults": {
                "max_points": 24
            }
        },
        "system_apps": {
            "enabled": true
        },
        "shell_control": {
            "enabled": true,
            "timeout_sec": 600,
            "max_timeout_sec": 10800,
            "max_output_chars": 120000
        },
        "reflex_capability": {
            "enabled": true
        }
    },
    "agentic_web": {
        "vision_enabled": false
    },
    "web_planner": {
        "max_provider_attempts_per_call": 1
    }
}
