@Meta: label="neural-network" version="5.0.0"

{{
    engine.visualState.updaters = [];
    engine.visualState.nodeUpdaters = [];
    engine.visualState.env.rotationSpeed = 0;
    engine.visualState.env.rotation = 0;
    engine.visualState.atlasSignal = engine.visualState.atlasSignal || {
        status: 'idle',
        micIntensity: 0,
        ttsIntensity: 0,
        isRecording: false,
        theme: 'dark'
    };

    engine.setBackground({
        type: 'hdri',
        sky: { top: '#020205', bottom: '#020205' },
        lights: [{ color: '#1d4ed8', pos: [0, 1, 0.5], intensity: 0.25 }]
    });
    engine.visualState.navigation.targetZoom = 132;
    engine.setParticleShape('orb');
    engine.setParticleMaterial(0);
    engine.setParticleSize(0.96);

    const totalActive = engine.config.activeCount;
    const coreCount = Math.floor(totalActive * 0.09);
    const crustCount = Math.floor(totalActive * 0.24);
    const ringCount = 0;
    const brainScaleX = 1.32;
    const brainScaleY = 1.24;
    const brainScaleZ = 1.18;
    const initialColor = new THREE.Color('#3b82f6');
    const crustMeta = new Array(crustCount);
    const ringBaseAngles = new Array(ringCount);
    const brainMeta = new Array(coreCount);

    function buildBrainPixels() {
        const doc = engine.documentObject || document;
        const canvas = doc.createElement('canvas');
        const width = 900;
        const height = 560;
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');

        ctx.clearRect(0, 0, width, height);
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.moveTo(176, 316);
        ctx.bezierCurveTo(150, 258, 185, 184, 268, 134);
        ctx.bezierCurveTo(348, 78, 492, 70, 615, 110);
        ctx.bezierCurveTo(745, 154, 790, 246, 758, 332);
        ctx.bezierCurveTo(720, 432, 592, 474, 430, 452);
        ctx.bezierCurveTo(298, 434, 205, 386, 176, 316);
        ctx.closePath();
        ctx.fill();

        ctx.beginPath();
        ctx.ellipse(298, 414, 118, 54, -0.06, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.ellipse(560, 408, 160, 70, -0.12, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.ellipse(694, 338, 74, 86, 0.28, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.ellipse(450, 458, 86, 42, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(432, 486);
        ctx.bezierCurveTo(432, 512, 438, 538, 450, 558);
        ctx.bezierCurveTo(462, 538, 468, 512, 468, 486);
        ctx.bezierCurveTo(458, 478, 442, 478, 432, 486);
        ctx.closePath();
        ctx.fill();

        ctx.globalCompositeOperation = 'destination-out';
        ctx.strokeStyle = '#000';
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        const grooves = [
            [[226, 292], [286, 244], [362, 260], [420, 216], [510, 224], [588, 182], [690, 218]],
            [[242, 354], [330, 324], [412, 344], [492, 302], [620, 318], [708, 278]],
            [[302, 178], [360, 210], [342, 278], [394, 326], [366, 392]],
            [[456, 132], [428, 196], [464, 252], [444, 322], [490, 402]],
            [[578, 134], [544, 202], [594, 258], [564, 344], [616, 416]],
            [[672, 202], [630, 250], [680, 314], [640, 382]],
            [[230, 260], [312, 292], [276, 354], [350, 390]],
            [[382, 148], [410, 192], [374, 236], [430, 292]],
            [[516, 162], [496, 218], [546, 264], [512, 330]],
            [[268, 418], [330, 386], [430, 414], [528, 382], [660, 404]],
            [[372, 450], [420, 434], [484, 438], [532, 456]],
            [[372, 474], [424, 462], [482, 462], [530, 476]],
            [[442, 488], [438, 514], [450, 542], [458, 558]]
        ];

        for (const groove of grooves) {
            ctx.lineWidth = 20;
            ctx.beginPath();
            ctx.moveTo(groove[0][0], groove[0][1]);
            for (let i = 1; i < groove.length - 1; i++) {
                const current = groove[i];
                const next = groove[i + 1];
                ctx.quadraticCurveTo(current[0], current[1], (current[0] + next[0]) * 0.5, (current[1] + next[1]) * 0.5);
            }
            const last = groove[groove.length - 1];
            ctx.lineTo(last[0], last[1]);
            ctx.stroke();
        }

        ctx.globalCompositeOperation = 'source-over';
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.ellipse(450, 444, 38, 30, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(436, 468);
        ctx.bezierCurveTo(438, 498, 442, 530, 450, 560);
        ctx.bezierCurveTo(458, 530, 462, 498, 464, 468);
        ctx.bezierCurveTo(454, 462, 446, 462, 436, 468);
        ctx.closePath();
        ctx.fill();

        const data = ctx.getImageData(0, 0, width, height).data;
        const pixels = [];
        for (let y = 0; y < height; y += 2) {
            for (let x = 0; x < width; x += 2) {
                const index = (y * width + x) * 4;
                if (data[index + 3] > 140) {
                    pixels.push({
                        u: (x / width) * 2 - 1,
                        v: 1 - (y / height) * 2,
                        edge: 1 - Math.min(1, Math.abs((x / width) * 2 - 1) * 0.75 + Math.abs(1 - (y / height) * 2) * 0.55)
                    });
                }
            }
        }
        return pixels;
    }

    const brainPixels = buildBrainPixels();

    function hash01(seed) {
        const value = Math.sin(seed * 127.1) * 43758.5453123;
        return value - Math.floor(value);
    }

    function randomBrainPoint(index) {
        const pixel = brainPixels[Math.floor(hash01(index + 101) * brainPixels.length) % brainPixels.length];
        const jitterX = (hash01(index + 3) - 0.5) * 0.65;
        const jitterY = (hash01(index + 17) - 0.5) * 0.65;
        const depthRand = hash01(index + 31) * 2 - 1;
        const fold = Math.sin(pixel.u * 15.0 + pixel.v * 6.0) * 0.55 + Math.sin(pixel.u * 8.0 - pixel.v * 14.0) * 0.35;
        const lowerPart = Math.max(0, -pixel.v - 0.48);
        const sideTaper = Math.max(0.08, 1.0 - Math.pow(Math.abs(pixel.u) * 0.88, 2));
        const cerebrumSideProfile = Math.max(0, 1.0 - Math.pow((pixel.v + 0.02) / 0.92, 2));
        const cerebellumProfile = Math.max(0, 1.0 - Math.pow((pixel.v + 0.64) / 0.26, 2)) * 0.46;
        const stemProfile = pixel.v < -0.72 ? 0.16 : 0.0;
        const lateralProfile = Math.max(cerebrumSideProfile, cerebellumProfile, stemProfile);
        const stemTaper = pixel.v < -0.72 ? 0.32 : 1.0;
        const depthEnvelope = Math.max(0.06, sideTaper * lateralProfile * stemTaper - lowerPart * 0.08);
        const x = pixel.u * 32.0 + jitterX;
        const y = pixel.v * 21.0 + jitterY - 1.6;
        const zCenter = -1.8 + Math.max(0, pixel.v + 0.22) * 2.8 - lowerPart * 4.0;
        const z = zCenter + depthRand * 22.0 * depthEnvelope + fold * 1.05 * Math.min(1, lateralProfile + 0.2);
        const side = x < 0 ? -1 : 1;
        return { x, y, z, side };
    }

    for (let i = 0; i < engine.config.particleCount; i++) {
        engine.roles[i] = 2;
        const i3 = i * 3;
        engine.basePositions[i3] = 0;
        engine.basePositions[i3 + 1] = 0;
        engine.basePositions[i3 + 2] = 0;
        engine.colors[i3] = initialColor.r;
        engine.colors[i3 + 1] = initialColor.g;
        engine.colors[i3 + 2] = initialColor.b;
        engine.targetColors[i3] = initialColor.r;
        engine.targetColors[i3 + 1] = initialColor.g;
        engine.targetColors[i3 + 2] = initialColor.b;
    }

    for (let i = 0; i < totalActive; i++) {
        const i3 = i * 3;

        if (i < coreCount) {
            engine.roles[i] = 0;
            const p = randomBrainPoint(i);
            const x = p.x * brainScaleX;
            const y = p.y * brainScaleY;
            const z = p.z * brainScaleZ;
            brainMeta[i] = { x, y, z, side: p.side, phase: Math.random() * Math.PI * 2 };
            engine.basePositions[i3] = x;
            engine.basePositions[i3 + 1] = y;
            engine.basePositions[i3 + 2] = z;
        } else if (i < coreCount + crustCount) {
            engine.roles[i] = 1;
            const idx = i - coreCount;
            const numLines = 36;
            const lineID = idx % numLines;
            const t = (Math.floor(idx / numLines) / (crustCount / numLines)) * 2 - 1;
            const phi = Math.acos(Math.max(-1, Math.min(1, t)));
            const spiralTurns = 3.5;
            const thetaJitter = (Math.random() - 0.5) * 0.015;
            const radius = 84 + (Math.random() - 0.5) * 2.0;
            const theta = (lineID * (Math.PI * 2 / numLines)) + (phi * spiralTurns) + thetaJitter;
            crustMeta[idx] = { phi, lineID, theta, radius };
            engine.basePositions[i3] = radius * Math.sin(phi) * Math.cos(theta);
            engine.basePositions[i3 + 1] = radius * Math.cos(phi);
            engine.basePositions[i3 + 2] = radius * Math.sin(phi) * Math.sin(theta);
        } else if (i < coreCount + crustCount + ringCount) {
            engine.roles[i] = 3;
            const radius = 58 + (Math.random() - 0.5) * 2.0;
            const angle = Math.random() * Math.PI * 2;
            ringBaseAngles[i - (coreCount + crustCount)] = angle;
            engine.basePositions[i3] = radius * Math.cos(angle);
            engine.basePositions[i3 + 1] = 0;
            engine.basePositions[i3 + 2] = radius * Math.sin(angle);
        } else {
            engine.roles[i] = 2;
            const theta = Math.random() * Math.PI * 2;
            const phi = Math.acos(2 * Math.random() - 1);
            const radius = 228 + Math.random() * 86;
            engine.basePositions[i3] = radius * Math.sin(phi) * Math.cos(theta);
            engine.basePositions[i3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
            engine.basePositions[i3 + 2] = radius * Math.cos(phi);
        }

        engine.positions[i3] = engine.basePositions[i3];
        engine.positions[i3 + 1] = engine.basePositions[i3 + 1];
        engine.positions[i3 + 2] = engine.basePositions[i3 + 2];
        engine.targetPositions[i3] = engine.basePositions[i3];
        engine.targetPositions[i3 + 1] = engine.basePositions[i3 + 1];
        engine.targetPositions[i3 + 2] = engine.basePositions[i3 + 2];
    }

    engine.setParticleRangeMaterial(0, coreCount, 1);
    engine.setParticleRangeMaterial(coreCount, coreCount + crustCount, 0);
    engine.setParticleRangeMaterial(coreCount + crustCount, coreCount + crustCount + ringCount, 1);
    engine.setParticleRangeMaterial(coreCount + crustCount + ringCount, totalActive, 0);

    const smooth = { intensity: 0 };

    engine.visualState.onUpdate = (time, delta) => {
        const signal = engine.visualState.atlasSignal || {};
        const currentVisualStatus = signal.status || 'idle';
        const rawIntensity = Math.max(
            currentVisualStatus === 'listening' && signal.isRecording ? (signal.micIntensity || 0) : 0,
            signal.ttsIntensity || 0
        );
        const easingFactor = rawIntensity > smooth.intensity ? 0.15 : 0.08;
        smooth.intensity += (rawIntensity - smooth.intensity) * easingFactor;
        const voiceIntensity = smooth.intensity;

        let coreColorHex = '#7ff8ff';
        let shellColorHex = '#07151d';
        let ringColorHex = '#2e5360';
        let atmosColorHex = '#050b12';

        if (currentVisualStatus === 'listening') {
            coreColorHex = '#57f4ff';
            shellColorHex = '#08212a';
            ringColorHex = '#3d7180';
            atmosColorHex = '#061923';
        } else if (currentVisualStatus === 'thinking') {
            coreColorHex = '#cdb8ff';
            shellColorHex = '#171228';
            ringColorHex = '#5e4b83';
            atmosColorHex = '#120f22';
        } else if (currentVisualStatus === 'speaking') {
            coreColorHex = '#ffa7d7';
            shellColorHex = '#21101a';
            ringColorHex = '#7a3557';
            atmosColorHex = '#160a11';
        }

        if ((signal.theme || 'dark') === 'light') {
            engine.setBackground({
                type: 'hdri',
                sky: { top: '#f3f4f6', bottom: '#e5e7eb' },
                lights: [{ color: '#60a5fa', pos: [0, 1, 0.5], intensity: 0.35 }]
            });
        } else {
            engine.setBackground({
                type: 'hdri',
                sky: { top: '#020205', bottom: '#020205' },
                lights: [{ color: '#1d4ed8', pos: [0, 1, 0.5], intensity: 0.25 }]
            });
        }

        const coreCol = new THREE.Color(coreColorHex);
        const shellCol = new THREE.Color(shellColorHex);
        const ringCol = new THREE.Color(ringColorHex);
        const atmosCol = new THREE.Color(atmosColorHex);

        for (let i = 0; i < totalActive; i++) {
            const i3 = i * 3;
            const role = engine.roles[i];

            let targetColor = coreCol;
            if (role === 1) {
                const shellPulse = 0.6 + 0.2 * Math.sin(time * 1.4 + i * 0.0008);
                targetColor = atmosCol.clone().lerp(shellCol, shellPulse);
            } else if (role === 2) {
                targetColor = atmosCol;
            } else if (role === 3) {
                const ringIndex = (i - (coreCount + crustCount)) % 3;
                let rotSpeed = time * 0.85;
                if (ringIndex === 1) rotSpeed = -time * 0.95;
                else if (ringIndex === 2) rotSpeed = time * 1.15;
                const baseAngle = Math.atan2(engine.basePositions[i3 + 2], engine.basePositions[i3]);
                const ringAngle = baseAngle + rotSpeed;
                const tailFactor = 0.12 + 0.88 * Math.pow((Math.sin(ringAngle) + 1.0) * 0.5, 4.0);
                targetColor = atmosCol.clone().lerp(ringCol, tailFactor);
            }

            engine.colors[i3] += (targetColor.r - engine.colors[i3]) * 0.08;
            engine.colors[i3 + 1] += (targetColor.g - engine.colors[i3 + 1]) * 0.08;
            engine.colors[i3 + 2] += (targetColor.b - engine.colors[i3 + 2]) * 0.08;
            engine.targetColors[i3] = targetColor.r;
            engine.targetColors[i3 + 1] = targetColor.g;
            engine.targetColors[i3 + 2] = targetColor.b;
        }

        const baseSize = currentVisualStatus === 'listening' ? 0.72 : 0.62;
        engine.setParticleSize(baseSize + voiceIntensity * 0.24);

        if (engine.skybox) {
            engine.skybox.rotation.y += (0.08 + voiceIntensity * 0.15) * 0.006;
        }

        for (let i = 0; i < totalActive; i++) {
            const i3 = i * 3;
            const role = engine.roles[i];
            let rx = engine.basePositions[i3];
            let ry = engine.basePositions[i3 + 1];
            let rz = engine.basePositions[i3 + 2];
            let cos = 1;
            let sin = 0;

            if (role === 0) {
                const brain = brainMeta[i];
                const hemisphereBob = 0.18 * Math.sin(time * 1.8 + brain.phase);
                const neuralFlutter = 0.12 * Math.sin(time * 5.2 + brain.phase * 1.7) * (0.18 + voiceIntensity);
                const lobeBreath = 1.0 + 0.015 * Math.sin(time * 1.25 + brain.side * 0.6);
                rx = brain.x * lobeBreath + brain.side * (0.85 + voiceIntensity * 0.55) + neuralFlutter;
                ry = brain.y * (1.0 + 0.014 * Math.sin(time * 1.1 + brain.phase)) + hemisphereBob;
                rz = brain.z * (1.0 + 0.016 * Math.cos(time * 1.5 + brain.phase));

                if (currentVisualStatus === 'thinking') {
                    const neuralStorm = 1.6;
                    rx += neuralStorm * Math.sin(time * 14.0 + brain.phase * 2.0);
                    ry += neuralStorm * Math.cos(time * 11.0 + brain.phase * 1.6);
                    rz += neuralStorm * Math.sin(time * 16.0 + brain.phase * 1.3);
                } else if (voiceIntensity > 0.02) {
                    const resonance = voiceIntensity * 3.2;
                    rx += resonance * Math.sin(time * 10.0 + brain.phase);
                    ry += resonance * Math.cos(time * 8.6 + brain.phase * 1.2);
                    rz += resonance * Math.sin(time * 9.8 + brain.phase * 1.4);
                }
            } else if (role === 1) {
                const angle = time * 0.10 + i * 0.0015;
                cos = Math.cos(angle);
                sin = Math.sin(angle);
                const tx = rx * cos + rz * sin;
                const tz = -rx * sin + rz * cos;
                rx = tx;
                rz = tz;
            } else if (role === 2) {
                const angle = time * 0.02 - i * 0.0004;
                cos = Math.cos(angle);
                sin = Math.sin(angle);
                const tx = rx * cos + rz * sin;
                const tz = -rx * sin + rz * cos;
                rx = tx;
                rz = tz;
            }

            if (role === 1) {
                const idx = i - coreCount;
                const crust = crustMeta[idx];
                const lineID = crust.lineID;
                const phi = crust.phi;
                const angle = time * 0.12 + idx * 0.0012;
                const activeTheta = crust.theta + angle;
                const radius = crust.radius;
                rx = radius * Math.sin(phi) * Math.cos(activeTheta);
                ry = radius * Math.cos(phi);
                rz = radius * Math.sin(phi) * Math.sin(activeTheta);

                const tilt = 0.06 * Math.sin(time * 0.5 + idx * 0.015);
                const cT = Math.cos(tilt);
                const sT = Math.sin(tilt);
                const ty = ry * cT - rz * sT;
                const tz = ry * sT + rz * cT;
                ry = ty;
                rz = tz;

                let radialPulse = 1.0;
                let waveOsc = 0.0;
                if (currentVisualStatus === 'thinking') {
                    waveOsc = 0.08 * Math.sin(phi * 12.0 - time * 28.0);
                    radialPulse = 1.0 + 0.06 * Math.sin(time * 20.0);
                } else if (voiceIntensity > 0.01) {
                    const voiceFactor = Math.pow(voiceIntensity, 1.2);
                    radialPulse = 1.0 + voiceFactor * 1.25;
                    const waveFreq = phi * 10.0 - time * 32.0 + lineID * 0.45;
                    waveOsc = voiceFactor * 0.65 * Math.sin(waveFreq);
                } else {
                    radialPulse = 1.0 + 0.04 * Math.sin(time * 1.6);
                    waveOsc = 0.02 * Math.sin(phi * 4.0 - time * 2.5);
                }

                const finalScale = radialPulse + waveOsc;
                rx *= finalScale;
                ry *= finalScale;
                rz *= finalScale;
            } else if (role === 3) {
                const ringIndex = (i - (coreCount + crustCount)) % 3;
                const ringSlot = i - (coreCount + crustCount);
                let rotSpeed = time * 0.85;
                if (ringIndex === 1) rotSpeed = -time * 0.95;
                else if (ringIndex === 2) rotSpeed = time * 1.15;
                const radius = 58;
                const baseAngle = ringBaseAngles[ringSlot];
                const ringAngle = baseAngle + rotSpeed;
                const waveCount = 5.0;
                const wavePattern = Math.sin(ringAngle * waveCount + time * 14.0);
                let pulseIntensity = 0.022;
                if (voiceIntensity > 0.02) {
                    pulseIntensity += voiceIntensity * 0.08;
                }
                const orbitBias = role === 3 ? 1.0 + Math.sin(time * 0.7 + ringSlot * 0.02) * 0.02 : 1.0;
                let ax = radius * Math.cos(ringAngle) * (1.0 + pulseIntensity * wavePattern) * orbitBias;
                let ay = 0;
                let az = radius * Math.sin(ringAngle) * (1.0 + pulseIntensity * wavePattern) * orbitBias;

                let tiltX = 0;
                let tiltY = 0;
                let tiltZ = 0;
                if (ringIndex === 0) {
                    tiltX = 35 * (Math.PI / 180);
                    tiltY = 20 * (Math.PI / 180);
                } else if (ringIndex === 1) {
                    tiltX = -35 * (Math.PI / 180);
                    tiltZ = 40 * (Math.PI / 180);
                } else {
                    tiltY = 70 * (Math.PI / 180);
                    tiltZ = -15 * (Math.PI / 180);
                }

                if (tiltX !== 0) {
                    const cosX = Math.cos(tiltX);
                    const sinX = Math.sin(tiltX);
                    const dy = ay * cosX - az * sinX;
                    const dz = ay * sinX + az * cosX;
                    ay = dy;
                    az = dz;
                }
                if (tiltY !== 0) {
                    const cosY = Math.cos(tiltY);
                    const sinY = Math.sin(tiltY);
                    const dx = ax * cosY + az * sinY;
                    const dz = -ax * sinY + az * cosY;
                    ax = dx;
                    az = dz;
                }
                if (tiltZ !== 0) {
                    const cosZ = Math.cos(tiltZ);
                    const sinZ = Math.sin(tiltZ);
                    const dx = ax * cosZ - ay * sinZ;
                    const dy = ax * sinZ + ay * cosZ;
                    ax = dx;
                    ay = dy;
                }

                rx = ax;
                ry = ay;
                rz = az;
            } else {
                const pulse = voiceIntensity > 0.02
                    ? 1.0 + voiceIntensity * 0.08 * Math.sin(time * 20.0 - 8.0 + i * 0.02)
                    : 1.0 + 0.03 * Math.sin(time * 1.2 + 1.6);
                rx *= pulse;
                ry *= pulse;
                rz *= pulse;
            }

            const yElevation = 10.0;
            engine.positions[i3] = rx;
            engine.positions[i3 + 1] = ry + yElevation;
            engine.positions[i3 + 2] = rz;
            engine.targetPositions[i3] = rx;
            engine.targetPositions[i3 + 1] = ry + yElevation;
            engine.targetPositions[i3 + 2] = rz;
        }
    };
}}
