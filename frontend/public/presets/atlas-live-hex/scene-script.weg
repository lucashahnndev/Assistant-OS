@Meta: label="HexaCube Core" version="1.0.0"

{{
    engine.visualState.updaters = [];
    engine.visualState.nodeUpdaters = [];
    engine.visualState.env.rotationSpeed = 0;
    engine.visualState.env.rotation = 0;
    engine.visualState.atlasSignal = engine.visualState.atlasSignal || {
        status: 'idle',
        micIntensity: 0,
        ttsIntensity: 0,
        isRecording: false,
        theme: 'dark'
    };

    engine.setBackground({
        type: 'color',
        sky: 'transparent',
        lights: [{ color: '#1d4ed8', pos: [0, 1, 0.5], intensity: 0.25 }]
    });
    
    // Zoom out slightly to fit the large cube
    engine.visualState.navigation.targetZoom = 190;
    engine.setParticleShape('orb');

    const totalActive = engine.config.particleCount; // e.g. 120,000
    
    // 1. Abstractions Distribution
    const coreCount = Math.max(100, Math.floor(totalActive * 0.15));        // 15% inner hyper-dense core
    const latticeCount = Math.max(100, Math.floor(totalActive * 0.60));     // 60% building the cube edges
    const dataStreamCount = Math.max(100, Math.floor(totalActive * 0.15));  // 15% running along the edges
    const satelliteCount = Math.max(100, totalActive - (coreCount + latticeCount + dataStreamCount)); // 10% outer floating points
    
    const initialColor = new THREE.Color('#3b82f6');
    
    // Geometric definitions for the Lattice
    const cubeSize = 50.0; // Base scale
    const phi = (1 + Math.sqrt(5)) / 2;
    // Icosahedron vertices (12 points)
    const vertices = [
        [0, 1, phi], [0, -1, phi], [0, 1, -phi], [0, -1, -phi],
        [1, phi, 0], [-1, phi, 0], [1, -phi, 0], [-1, -phi, 0],
        [phi, 0, 1], [-phi, 0, 1], [phi, 0, -1], [-phi, 0, -1]
    ];
    
    // Automatically find all 30 edges (distance squared = 4)
    const edges = [];
    const faces = [];
    for (let i = 0; i < vertices.length; i++) {
        for (let j = i + 1; j < vertices.length; j++) {
            const dxIJ = vertices[i][0] - vertices[j][0];
            const dyIJ = vertices[i][1] - vertices[j][1];
            const dzIJ = vertices[i][2] - vertices[j][2];
            const dSqIJ = dxIJ*dxIJ + dyIJ*dyIJ + dzIJ*dzIJ;
            const isEdgeIJ = Math.abs(dSqIJ - 4.0) < 0.1;
            
            if (isEdgeIJ) edges.push([i, j]);
            
            for (let k = j + 1; k < vertices.length; k++) {
                if (!isEdgeIJ) continue;
                
                const dxJK = vertices[j][0] - vertices[k][0];
                const dyJK = vertices[j][1] - vertices[k][1];
                const dzJK = vertices[j][2] - vertices[k][2];
                const dSqJK = dxJK*dxJK + dyJK*dyJK + dzJK*dzJK;
                
                const dxKI = vertices[k][0] - vertices[i][0];
                const dyKI = vertices[k][1] - vertices[i][1];
                const dzKI = vertices[k][2] - vertices[i][2];
                const dSqKI = dxKI*dxKI + dyKI*dyKI + dzKI*dzKI;
                
                if (Math.abs(dSqJK - 4.0) < 0.1 && Math.abs(dSqKI - 4.0) < 0.1) {
                    faces.push([i, j, k]); // Found a triangle face
                }
            }
        }
    }
    const numEdges = edges.length; // 30

    // Meta arrays for specialized animation
    const streamMeta = new Array(dataStreamCount);
    const satelliteMeta = new Array(satelliteCount);

    for (let i = 0; i < totalActive; i++) {
        const i3 = i * 3;

        if (i < coreCount) {
            // ROLE 0: Core (Dense chaotic inner sphere)
            engine.roles[i] = 0;
            const theta = Math.random() * Math.PI * 2.0;
            const phi = Math.acos(2.0 * Math.random() - 1.0);
            const radius = 10.0 + Math.random() * 15.0;
            engine.basePositions[i3] = radius * Math.sin(phi) * Math.cos(theta);
            engine.basePositions[i3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
            engine.basePositions[i3 + 2] = radius * Math.cos(phi);
        } else if (i < coreCount + latticeCount) {
            // ROLE 1: Lattice (Edges and Mesh Faces)
            engine.roles[i] = 1;
            
            // 15% on the sharp edges, 85% filling the mesh faces
            const isOnFace = Math.random() < 0.85; 
            
            if (!isOnFace) {
                const edgeIdx = Math.floor(Math.random() * numEdges);
                const t = Math.random(); 
                const v1 = vertices[edges[edgeIdx][0]];
                const v2 = vertices[edges[edgeIdx][1]];
                
                const jitter = 0.5;
                const jX = (Math.random() - 0.5) * jitter;
                const jY = (Math.random() - 0.5) * jitter;
                const jZ = (Math.random() - 0.5) * jitter;

                engine.basePositions[i3] = (v1[0] + (v2[0] - v1[0]) * t) * cubeSize + jX;
                engine.basePositions[i3 + 1] = (v1[1] + (v2[1] - v1[1]) * t) * cubeSize + jY;
                engine.basePositions[i3 + 2] = (v1[2] + (v2[2] - v1[2]) * t) * cubeSize + jZ;
            } else {
                const faceIdx = Math.floor(Math.random() * faces.length);
                const v1 = vertices[faces[faceIdx][0]];
                const v2 = vertices[faces[faceIdx][1]];
                const v3 = vertices[faces[faceIdx][2]];
                
                let r1 = Math.random();
                let r2 = Math.random();
                if (r1 + r2 > 1.0) {
                    r1 = 1.0 - r1;
                    r2 = 1.0 - r2;
                }
                
                // Randomly hollow out some faces to make it look like a technical mesh
                if (Math.random() < 0.3) {
                    r1 = 0; r2 = 0; // fallback to vertex if "empty" hole
                }

                engine.basePositions[i3] = (v1[0] + r1 * (v2[0] - v1[0]) + r2 * (v3[0] - v1[0])) * cubeSize;
                engine.basePositions[i3 + 1] = (v1[1] + r1 * (v2[1] - v1[1]) + r2 * (v3[1] - v1[1])) * cubeSize;
                engine.basePositions[i3 + 2] = (v1[2] + r1 * (v2[2] - v1[2]) + r2 * (v3[2] - v1[2])) * cubeSize;
            }
        } else if (i < coreCount + latticeCount + dataStreamCount) {
            // ROLE 2: Data Streams (Packets running along edges)
            engine.roles[i] = 2;
            const idx = i - (coreCount + latticeCount);
            const edgeIdx = idx % numEdges;
            
            streamMeta[idx] = {
                edgeIdx: edgeIdx,
                speed: 0.2 + Math.random() * 0.8, // Base speed
                offset: Math.random() * Math.PI * 2,
                direction: Math.random() > 0.5 ? 1 : -1
            };
            
            engine.basePositions[i3] = 0;
            engine.basePositions[i3 + 1] = 0;
            engine.basePositions[i3 + 2] = 0;
        } else {
            // ROLE 3: Satellites (Scanning outer ring/lattice points)
            engine.roles[i] = 3;
            const idx = i - (coreCount + latticeCount + dataStreamCount);
            const radius = cubeSize * 1.6 + Math.random() * 20.0;
            const angle = Math.random() * Math.PI * 2;
            const axis = Math.floor(Math.random() * 3); // Orbit around X, Y, or Z
            
            satelliteMeta[idx] = {
                radius: radius,
                angle: angle,
                axis: axis,
                speed: (0.1 + Math.random() * 0.2) * (Math.random() > 0.5 ? 1 : -1)
            };
            
            engine.basePositions[i3] = 0;
            engine.basePositions[i3 + 1] = 0;
            engine.basePositions[i3 + 2] = 0;
        }

        engine.positions[i3] = engine.basePositions[i3];
        engine.positions[i3 + 1] = engine.basePositions[i3 + 1];
        engine.positions[i3 + 2] = engine.basePositions[i3 + 2];
        engine.targetPositions[i3] = engine.basePositions[i3];
        engine.targetPositions[i3 + 1] = engine.basePositions[i3 + 1];
        engine.targetPositions[i3 + 2] = engine.basePositions[i3 + 2];
        
        engine.colors[i3] = initialColor.r;
        engine.colors[i3 + 1] = initialColor.g;
        engine.colors[i3 + 2] = initialColor.b;
        engine.targetColors[i3] = initialColor.r;
        engine.targetColors[i3 + 1] = initialColor.g;
        engine.targetColors[i3 + 2] = initialColor.b;
    }

    // Material Assignments
    engine.setParticleRangeMaterial(0, coreCount, 0); // Core: Additive (Glow)
    engine.setParticleRangeMaterial(coreCount, coreCount + latticeCount, 1); // Lattice: Solid Mesh
    engine.setParticleRangeMaterial(coreCount + latticeCount, coreCount + latticeCount + dataStreamCount, 0); // Data Streams: Glow
    engine.setParticleRangeMaterial(coreCount + latticeCount + dataStreamCount, totalActive, 0); // Satellites: Glow

    const smooth = { intensity: 0 };

    engine.visualState.onUpdate = (time, delta) => {
        const signal = engine.visualState.atlasSignal || {};
        const currentVisualStatus = signal.status || 'idle';
        const rawIntensity = Math.max(
            currentVisualStatus === 'listening' && signal.isRecording ? (signal.micIntensity || 0) : 0,
            signal.ttsIntensity || 0
        );
        const easingFactor = rawIntensity > smooth.intensity ? 0.15 : 0.08;
        smooth.intensity += (rawIntensity - smooth.intensity) * easingFactor;
        const voiceIntensity = smooth.intensity;

        // Tesseract Colors
        let coreColorHex = '#ff0055';    // Neon Pink
        let latticeColorHex = '#00f2ff'; // Cyan
        let streamColorHex = '#ffffff';  // Pure White streams
        let satColorHex = '#00a8ff';

        if (currentVisualStatus === 'listening') {
            coreColorHex = '#00f2ff';
            latticeColorHex = '#00a8ff';
            streamColorHex = '#a8f2ff';
            satColorHex = '#ffffff';
        } else if (currentVisualStatus === 'thinking') {
            coreColorHex = '#b895f2';
            latticeColorHex = '#6e3bc2';
            streamColorHex = '#ff00a0';
            satColorHex = '#9d4edd';
        } else if (currentVisualStatus === 'speaking') {
            coreColorHex = '#ff0055';
            latticeColorHex = '#ff9bcf';
            streamColorHex = '#ffffff';
            satColorHex = '#ff7ec3';
        }

        const coreCol = new THREE.Color(coreColorHex);
        const latticeCol = new THREE.Color(latticeColorHex);
        const streamCol = new THREE.Color(streamColorHex);
        const satCol = new THREE.Color(satColorHex);

        // Global Cube Rotation
        const globalRotX = time * 0.15;
        const globalRotY = time * 0.20;
        const cx = Math.cos(globalRotX), sx = Math.sin(globalRotX);
        const cy = Math.cos(globalRotY), sy = Math.sin(globalRotY);

        for (let i = 0; i < totalActive; i++) {
            const i3 = i * 3;
            const role = engine.roles[i];

            let targetColor = coreCol;
            if (role === 1) targetColor = latticeCol;
            else if (role === 2) targetColor = streamCol;
            else if (role === 3) targetColor = satCol;

            engine.colors[i3] += (targetColor.r - engine.colors[i3]) * 0.1;
            engine.colors[i3 + 1] += (targetColor.g - engine.colors[i3 + 1]) * 0.1;
            engine.colors[i3 + 2] += (targetColor.b - engine.colors[i3 + 2]) * 0.1;

            let rx = engine.basePositions[i3];
            let ry = engine.basePositions[i3 + 1];
            let rz = engine.basePositions[i3 + 2];

            if (role === 0) {
                // CORE LOGIC
                let pulse = 1.0;
                if (currentVisualStatus === 'thinking') {
                    // Hyper-collapse and morphing
                    const chaos = time * 15.0 + i * 0.1;
                    rx += 4.0 * Math.sin(chaos * 1.3);
                    ry += 4.0 * Math.cos(chaos * 1.1);
                    rz += 4.0 * Math.sin(chaos * 0.9);
                    pulse = 0.6 + 0.6 * Math.sin(time * 30.0 + i * 0.05);
                } else if (voiceIntensity > 0.05) {
                    const audioBump = voiceIntensity * 5.0;
                    rx *= (1.0 + audioBump * 0.2 * Math.sin(time * 10.0 + i));
                    ry *= (1.0 + audioBump * 0.2 * Math.cos(time * 12.0 + i));
                    rz *= (1.0 + audioBump * 0.2 * Math.sin(time * 8.0 + i));
                }
                rx *= pulse; ry *= pulse; rz *= pulse;
            } 
            else if (role === 1) {
                // LATTICE LOGIC (Rigid structure, slightly expanding on audio)
                let scale = 1.0;
                if (voiceIntensity > 0.05) {
                    scale = 1.0 + (voiceIntensity * 0.15); // Cube inflates on voice
                }
                if (currentVisualStatus === 'listening') {
                    // Slight vibration when listening
                    rx += Math.sin(time * 40.0 + i) * 0.5;
                    ry += Math.cos(time * 42.0 + i) * 0.5;
                    rz += Math.sin(time * 38.0 + i) * 0.5;
                }
                rx *= scale; ry *= scale; rz *= scale;
            }
            else if (role === 2) {
                // DATA STREAMS LOGIC
                const idx = i - (coreCount + latticeCount);
                const meta = streamMeta[idx];
                
                // Speed multiplier based on state
                let speedMult = 1.0;
                if (currentVisualStatus === 'thinking') speedMult = 5.0; // Data runs extremely fast
                else if (currentVisualStatus === 'listening') speedMult = 0.2; // Data slows down
                else if (voiceIntensity > 0.05) speedMult = 1.0 + (voiceIntensity * 3.0);
                
                // Calculate position along edge
                let rawT = (time * meta.speed * speedMult * meta.direction) + meta.offset;
                // Ping-pong between 0 and 1
                let t = Math.abs((rawT % 2.0) - 1.0); 
                
                const v1 = vertices[edges[meta.edgeIdx][0]];
                const v2 = vertices[edges[meta.edgeIdx][1]];
                
                // Jitter for data streams
                const jitter = 2.0;
                const jX = (Math.sin(time * 10.0 + i) * jitter);
                const jY = (Math.cos(time * 12.0 + i) * jitter);
                const jZ = (Math.sin(time * 8.0 + i) * jitter);
                
                let scale = 1.0;
                if (voiceIntensity > 0.05) scale = 1.0 + (voiceIntensity * 0.15);

                rx = ((v1[0] + (v2[0] - v1[0]) * t) * cubeSize + jX) * scale;
                ry = ((v1[1] + (v2[1] - v1[1]) * t) * cubeSize + jY) * scale;
                rz = ((v1[2] + (v2[2] - v1[2]) * t) * cubeSize + jZ) * scale;
            }
            else if (role === 3) {
                // SATELLITE LOGIC
                const idx = i - (coreCount + latticeCount + dataStreamCount);
                const meta = satelliteMeta[idx];
                
                let speedMult = 1.0;
                if (currentVisualStatus === 'listening') speedMult = 4.0; // Satellites spin fast while scanning
                
                const currentAngle = meta.angle + (time * meta.speed * speedMult);
                
                let px = Math.cos(currentAngle) * meta.radius;
                let py = 0;
                let pz = Math.sin(currentAngle) * meta.radius;
                
                // Orient based on axis
                if (meta.axis === 0) { // Orbit X
                    rx = 0; ry = px; rz = pz;
                } else if (meta.axis === 1) { // Orbit Y
                    rx = px; ry = 0; rz = pz;
                } else { // Orbit Z
                    rx = px; ry = pz; rz = 0;
                }
            }

            // Apply Global Cube Rotation
            // Rotate Y
            let tx = rx * cy + rz * sy;
            let tz = -rx * sy + rz * cy;
            rx = tx; rz = tz;
            
            // Rotate X
            let ty = ry * cx - rz * sx;
            tz = ry * sx + rz * cx;
            ry = ty; rz = tz;

            // Optional tilt specific to role
            if (role === 1 || role === 2) {
                const tilt = 0.05 * Math.sin(time * 0.5);
                const cT = Math.cos(tilt), sT = Math.sin(tilt);
                const tyy = ry * cT - rz * sT;
                const tzz = ry * sT + rz * cT;
                ry = tyy; rz = tzz;
            }

            const yElevation = 10.0;
            engine.positions[i3] = rx;
            engine.positions[i3 + 1] = ry + yElevation;
            engine.positions[i3 + 2] = rz;
            
            // Particles instantly snap to target to maintain strict geometry
            engine.targetPositions[i3] = engine.positions[i3];
            engine.targetPositions[i3 + 1] = engine.positions[i3 + 1];
            engine.targetPositions[i3 + 2] = engine.positions[i3 + 2];
        }

        const baseSize = 0.85;
        engine.setParticleSize(baseSize + voiceIntensity * 0.4);
    };
}}
