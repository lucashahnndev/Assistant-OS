@Meta: label="neon-waves" version="1.0.0"

{{
    engine.visualState.updaters = [];
    engine.visualState.nodeUpdaters = [];
    engine.visualState.env.rotationSpeed = 0;
    engine.visualState.env.rotation = 0;
    engine.visualState.atlasSignal = engine.visualState.atlasSignal || {
        status: 'idle',
        micIntensity: 0,
        ttsIntensity: 0,
        isRecording: false,
        theme: 'dark'
    };

    engine.setBackground({
        type: 'hdri',
        sky: { top: '#0a101f', bottom: '#000000' },
        lights: [{ color: '#1d4ed8', pos: [0, 1, 0.5], intensity: 0.15 }]
    });
    
    // Zoom in a bit more since it's a flat surface
    engine.visualState.navigation.targetZoom = 135;
    engine.setParticleShape('orb');
    engine.setParticleMaterial(0);
    
    const safeDensity = engine.config.particleCount;
    const totalActive = engine.config.particleCount;
    engine.setDensity(safeDensity, false);
    
    // Create a massive grid for the waves
    const width = 1600;
    const depth = 1200;
    const C = Math.floor(Math.sqrt(totalActive * (width / depth)));
    const R = Math.floor(totalActive / C);

    for (let i = 0; i < totalActive; i++) {
        const row = Math.floor(i / C);
        const col = i % C;
        
        // Jittered grid to avoid moire patterns
        const x = (col / C) * width - (width / 2) + (Math.random() - 0.5) * 1.5;
        const z = (row / R) * depth - (depth / 2) + (Math.random() - 0.5) * 1.5;
        
        engine.roles[i] = 1;
        const i3 = i * 3;
        engine.basePositions[i3] = x;
        engine.basePositions[i3 + 1] = 0;
        engine.basePositions[i3 + 2] = z;
        
        engine.colors[i3] = 0;
        engine.colors[i3 + 1] = 0;
        engine.colors[i3 + 2] = 0;
        engine.targetColors[i3] = 0;
        engine.targetColors[i3 + 1] = 0;
        engine.targetColors[i3 + 2] = 0;
    }

    engine.setParticleRangeMaterial(0, totalActive, 0);

    const smooth = { intensity: 0 };
    
    // Neon Cyberpunk colors
    const colorA = { r: 15/255, g: 0/255, b: 65/255 };    // Deep Abyss Purple
    const colorB = { r: 195/255, g: 25/255, b: 255/255 }; // Electric Magenta/Pink
    const colorC = { r: 0/255, g: 245/255, b: 255/255 };  // Bright Cyan

    engine.visualState.onUpdate = (time, delta) => {
        const signal = engine.visualState.atlasSignal || {};
        const currentVisualStatus = signal.status || 'idle';
        const rawIntensity = Math.max(
            currentVisualStatus === 'listening' && signal.isRecording ? (signal.micIntensity || 0) : 0,
            signal.ttsIntensity || 0
        );
        const easingFactor = rawIntensity > smooth.intensity ? 0.25 : 0.08;
        smooth.intensity += (rawIntensity - smooth.intensity) * easingFactor;
        const voiceIntensity = smooth.intensity;

        // Dynamic camera slight rotation effect
        if (engine.skybox) {
            engine.skybox.rotation.y += (0.02 + voiceIntensity * 0.1) * 0.006;
        }

        // Tilt grid slightly forwards to give a horizon perspective
        const tiltAngle = 0.35; 
        const cosTilt = Math.cos(tiltAngle);
        const sinTilt = Math.sin(tiltAngle);
        
        const speed = time * 0.25;

        for (let i = 0; i < totalActive; i++) {
            const i3 = i * 3;
            let px = engine.basePositions[i3];
            let pz = engine.basePositions[i3 + 2];
            
            // Primary slow rolling waves
            let wave1 = Math.sin(px * 0.012 - speed) * Math.cos(pz * 0.008 + speed * 0.8) * 42.0;
            
            // Secondary high-frequency ripples
            let wave2 = Math.sin(px * 0.035 + speed * 1.5) * Math.sin(pz * 0.028 - speed * 1.2) * 14.0;
            
            // Audio reactive central burst
            let wave3 = 0;
            if (voiceIntensity > 0.01) {
                 const distToCenter = Math.sqrt(px*px + pz*pz);
                 const safeDist = Math.max(1.0, distToCenter);
                 const ringEffect = Math.sin(safeDist * 0.06 - time * 12.0);
                 const dropoff = Math.max(0, 1.0 - safeDist / 220.0);
                 wave3 = ringEffect * (voiceIntensity * 45.0) * dropoff;
            }
            
            // Combine and lower everything
            let py = wave1 + wave2 + wave3 - 45.0;
            
            // Apply artificial camera tilt directly to points
            let finalY = py * cosTilt - pz * sinTilt;
            let finalZ = py * sinTilt + pz * cosTilt;
            
            engine.positions[i3] = px;
            engine.positions[i3 + 1] = finalY;
            engine.positions[i3 + 2] = finalZ;
            engine.targetPositions[i3] = px;
            engine.targetPositions[i3 + 1] = finalY;
            engine.targetPositions[i3 + 2] = finalZ;
            
            // Color Mapping based on vertical height
            // py ranges from ~ -100 to +30. Normalize it to 0.0 -> 1.0
            let heightNorm = (py + 95.0) / 105.0;
            heightNorm = Math.max(0.0, Math.min(1.0, heightNorm));
            
            // Interpolate colors dynamically
            let tr, tg, tb;
            if (heightNorm < 0.45) {
                 const f = heightNorm / 0.45;
                 tr = colorA.r + (colorB.r - colorA.r) * f;
                 tg = colorA.g + (colorB.g - colorA.g) * f;
                 tb = colorA.b + (colorB.b - colorA.b) * f;
            } else {
                 const f = (heightNorm - 0.45) / 0.55;
                 tr = colorB.r + (colorC.r - colorB.r) * f;
                 tg = colorB.g + (colorC.g - colorB.g) * f;
                 tb = colorB.b + (colorC.b - colorB.b) * f;
            }
            
            // Audio reactive brightness flash
            if (voiceIntensity > 0.3) {
                 const flash = (voiceIntensity - 0.3) * 0.4;
                 tr = Math.min(1.0, tr + flash);
                 tg = Math.min(1.0, tg + flash);
                 tb = Math.min(1.0, tb + flash);
            }
            
            // Fast linear interpolation for smooth color transitions
            engine.colors[i3] += (tr - engine.colors[i3]) * 0.15;
            engine.colors[i3 + 1] += (tg - engine.colors[i3 + 1]) * 0.15;
            engine.colors[i3 + 2] += (tb - engine.colors[i3 + 2]) * 0.15;
            engine.targetColors[i3] = tr;
            engine.targetColors[i3 + 1] = tg;
            engine.targetColors[i3 + 2] = tb;
        }
        
        // Base particle size
        const baseSize = 3.0;
        engine.setParticleSize(baseSize + voiceIntensity * 0.45);
    };
}}
