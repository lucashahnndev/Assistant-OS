@Meta: label="ai-orb-classic" version="5.0.0"

{{
    engine.visualState.updaters = [];
    engine.visualState.nodeUpdaters = [];
    engine.visualState.env.rotationSpeed = 0;
    engine.visualState.env.rotation = 0;
    engine.visualState.atlasSignal = engine.visualState.atlasSignal || {
        status: 'idle',
        micIntensity: 0,
        ttsIntensity: 0,
        isRecording: false,
        theme: 'dark'
    };

    engine.setBackground({
        type: 'color',
        sky: 'transparent',
        lights: [{ color: '#1d4ed8', pos: [0, 1, 0.5], intensity: 0.25 }]
    });
    engine.visualState.navigation.targetZoom = 165;
    engine.setParticleShape('orb');
    engine.setParticleMaterial(0);
    const targetDensity = 120000;
    const safeDensity = engine.config.particleCount;
    const totalActive = engine.config.particleCount;
    const coreCount = 0; // Removed vestigial core
    const crustCount = Math.max(100, Math.floor(totalActive * 0.40)); // Hollow energy shell
    const ringCount = Math.max(100, Math.floor(totalActive * 0.15)); // Orbital rings
    const initialColor = new THREE.Color('#3b82f6');
    const crustMeta = new Array(crustCount);
    const ringBaseAngles = new Array(ringCount);

    for (let i = 0; i < engine.config.particleCount; i++) {
        engine.roles[i] = 2;
        const i3 = i * 3;
        engine.basePositions[i3] = 0;
        engine.basePositions[i3 + 1] = 0;
        engine.basePositions[i3 + 2] = 0;
        engine.colors[i3] = initialColor.r;
        engine.colors[i3 + 1] = initialColor.g;
        engine.colors[i3 + 2] = initialColor.b;
        engine.targetColors[i3] = initialColor.r;
        engine.targetColors[i3 + 1] = initialColor.g;
        engine.targetColors[i3 + 2] = initialColor.b;
    }

    for (let i = 0; i < totalActive; i++) {
        const i3 = i * 3;

        if (i < coreCount) {
            engine.roles[i] = 0;
            const theta = Math.random() * Math.PI * 2.0;
            const phi = Math.acos(2.0 * Math.random() - 1.0);
            const radius = 18.0 + Math.random() * 12.0;
            engine.basePositions[i3] = radius * Math.sin(phi) * Math.cos(theta);
            engine.basePositions[i3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
            engine.basePositions[i3 + 2] = radius * Math.cos(phi);
        } else if (i < coreCount + crustCount) {
            engine.roles[i] = 1;
            const idx = i - coreCount;
            const numLines = 36;
            const lineID = idx % numLines;
            
            // Safe normalized placement along the spiral
            let t = (Math.floor(idx / numLines) / Math.max(1, Math.floor(crustCount / numLines))) * 2.0 - 1.0;
            t = Math.max(-1.0, Math.min(1.0, t)); 
            const phi = Math.acos(t);
            
            const spiralTurns = 3.5;
            const thetaJitter = (Math.random() - 0.5) * 0.015;
            // Abstract hollow energy shell radius
            const radius = 45.0 + (Math.random() - 0.5) * 4.0;
            const theta = (lineID * (Math.PI * 2 / numLines)) + (phi * spiralTurns) + thetaJitter;
            
            crustMeta[idx] = { phi: phi, lineID: lineID, theta: theta, radius: radius };
            
            engine.basePositions[i3] = radius * Math.sin(phi) * Math.cos(theta);
            engine.basePositions[i3 + 1] = radius * Math.cos(phi);
            engine.basePositions[i3 + 2] = radius * Math.sin(phi) * Math.sin(theta);
        } else if (i < coreCount + crustCount + ringCount) {
            engine.roles[i] = 3;
            const radius = 65.0 + (Math.random() - 0.5) * 3.0;
            const angle = Math.random() * Math.PI * 2;
            ringBaseAngles[i - (coreCount + crustCount)] = angle;
            engine.basePositions[i3] = radius * Math.cos(angle);
            engine.basePositions[i3 + 1] = 0;
            engine.basePositions[i3 + 2] = radius * Math.sin(angle);
        } else {
            engine.roles[i] = 2;
            const theta = Math.random() * Math.PI * 2;
            const phi = Math.acos(2 * Math.random() - 1);
            const radius = 120 + Math.random() * 45;
            engine.basePositions[i3] = radius * Math.sin(phi) * Math.cos(theta);
            engine.basePositions[i3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
            engine.basePositions[i3 + 2] = radius * Math.cos(phi);
        }

        engine.positions[i3] = engine.basePositions[i3];
        engine.positions[i3 + 1] = engine.basePositions[i3 + 1];
        engine.positions[i3 + 2] = engine.basePositions[i3 + 2];
        engine.targetPositions[i3] = engine.basePositions[i3];
        engine.targetPositions[i3 + 1] = engine.basePositions[i3 + 1];
        engine.targetPositions[i3 + 2] = engine.basePositions[i3 + 2];
    }

    engine.setParticleRangeMaterial(0, coreCount, 1);
    engine.setParticleRangeMaterial(coreCount, coreCount + crustCount, 0);
    engine.setParticleRangeMaterial(coreCount + crustCount, coreCount + crustCount + ringCount, 1);
    engine.setParticleRangeMaterial(coreCount + crustCount + ringCount, totalActive, 0);

    const smooth = { intensity: 0, peak: 0 };

    engine.visualState.onUpdate = (time, delta) => {
        const signal = engine.visualState.atlasSignal || {};
        const currentVisualStatus = signal.status || 'idle';
        
        const rawMic = currentVisualStatus === 'listening' ? (signal.micIntensity || 0) : 0;
        const rawTts = currentVisualStatus === 'speaking' ? (signal.ttsIntensity || 0) : 0;
        const rawIntensity = Math.max(rawMic, rawTts);
        
        // Fast attack, smooth decay for realistic audio reactivity
        const attack = 0.5;
        const decay = 0.15;
        smooth.intensity += (rawIntensity - smooth.intensity) * (rawIntensity > smooth.intensity ? attack : decay);
        
        // Track peaks for bass-like bursts
        if (rawIntensity > smooth.peak) {
            smooth.peak = rawIntensity;
        } else {
            smooth.peak += (0 - smooth.peak) * 0.05; // slow peak decay
        }

        const voiceIntensity = smooth.intensity;
        const peakIntensity = smooth.peak;

        let coreColorHex = '#9ffcff';
        let shellColorHex = '#59d3f0';
        let ringColorHex = '#bdeeff';
        let atmosColorHex = '#0d2230';

        if (currentVisualStatus === 'listening') {
            coreColorHex = '#6ffcff';
            shellColorHex = '#39dff5';
            ringColorHex = '#78f7ff';
            atmosColorHex = '#0a2e3c';
        } else if (currentVisualStatus === 'thinking') {
            coreColorHex = '#cbbcff';
            shellColorHex = '#d2b7ff';
            ringColorHex = '#b895f2';
            atmosColorHex = '#2f2c74';
        } else if (currentVisualStatus === 'speaking') {
            coreColorHex = '#ffb1da';
            shellColorHex = '#ff9bcf';
            ringColorHex = '#ff7ec3';
            atmosColorHex = '#5b1837';
        }

        if ((signal.theme || 'dark') === 'light') {
            engine.setBackground({
                type: 'hdri',
                sky: { top: '#f3f4f6', bottom: '#e5e7eb' },
                lights: [{ color: '#60a5fa', pos: [0, 1, 0.5], intensity: 0.35 }]
            });
        } else {
            engine.setBackground({
                type: 'color',
                sky: 'transparent',
                lights: [{ color: '#1d4ed8', pos: [0, 1, 0.5], intensity: 0.25 }]
            });
            if (engine.scene) engine.scene.background = null;
        }

        const coreCol = new THREE.Color(coreColorHex);
        const shellCol = new THREE.Color(shellColorHex);
        const ringCol = new THREE.Color(ringColorHex);
        const atmosCol = new THREE.Color(atmosColorHex);

        for (let i = 0; i < totalActive; i++) {
            const i3 = i * 3;
            const role = engine.roles[i];

            let targetColor = coreCol;
            if (role === 1) {
                const shellPulse = 0.6 + 0.2 * Math.sin(time * 1.4 + i * 0.0008);
                targetColor = atmosCol.clone().lerp(shellCol, shellPulse);
                // Audio reactive color burst
                if (peakIntensity > 0.2) {
                    targetColor.lerp(coreCol, peakIntensity * 0.5);
                }
            }
            else if (role === 2) targetColor = atmosCol;
            else if (role === 3) {
                const ringIndex = (i - (coreCount + crustCount)) % 3;
                let rotSpeed = time * 0.85;
                if (ringIndex === 1) rotSpeed = -time * 0.95;
                else if (ringIndex === 2) rotSpeed = time * 1.15;
                const baseAngle = Math.atan2(engine.basePositions[i3 + 2], engine.basePositions[i3]);
                const ringAngle = baseAngle + rotSpeed;
                const tailFactor = 0.12 + 0.88 * Math.pow((Math.sin(ringAngle) + 1.0) * 0.5, 4.0);
                targetColor = atmosCol.clone().lerp(ringCol, tailFactor);
                // Rings glow harder on audio peak
                if (peakIntensity > 0.1) {
                    targetColor.lerp(new THREE.Color('#ffffff'), peakIntensity * 0.4);
                }
            }

            engine.colors[i3] += (targetColor.r - engine.colors[i3]) * 0.08;
            engine.colors[i3 + 1] += (targetColor.g - engine.colors[i3 + 1]) * 0.08;
            engine.colors[i3 + 2] += (targetColor.b - engine.colors[i3 + 2]) * 0.08;
            engine.targetColors[i3] = targetColor.r;
            engine.targetColors[i3 + 1] = targetColor.g;
            engine.targetColors[i3 + 2] = targetColor.b;
        }

        const baseSize = currentVisualStatus === 'listening' ? 1.05 : 0.90;
        // Dynamic size reactive to audio
        engine.setParticleSize(baseSize + voiceIntensity * 0.45);

        if (engine.skybox) {
            engine.skybox.rotation.y += (0.05 + voiceIntensity * 0.2) * 0.006;
        }

        for (let i = 0; i < totalActive; i++) {
            const i3 = i * 3;
            const role = engine.roles[i];
            let rx = engine.basePositions[i3];
            let ry = engine.basePositions[i3 + 1];
            let rz = engine.basePositions[i3 + 2];
            let cos = 1;
            let sin = 0;

            if (role === 2) {
                const angle = time * 0.02 - i * 0.0004;
                cos = Math.cos(angle);
                sin = Math.sin(angle);
                const tx = rx * cos + rz * sin;
                const tz = -rx * sin + rz * cos;
                rx = tx;
                rz = tz;
            }

            let pulse = 1.0;
            
            if (role === 1) {
                // Sphere crust / shell
                const idx = i - coreCount;
                const crust = crustMeta[idx];
                const lineID = crust.lineID;
                const phi = crust.phi;
                
                // Keep the spherical shape, add rotation
                const baseAngle = time * 0.12 + idx * 0.0012;
                const activeTheta = crust.theta + baseAngle;
                const radius = crust.radius;
                
                rx = radius * Math.sin(phi) * Math.cos(activeTheta);
                ry = radius * Math.cos(phi);
                rz = radius * Math.sin(phi) * Math.sin(activeTheta);

                // Add a subtle wobble
                const tilt = 0.06 * Math.sin(time * 0.5 + idx * 0.015);
                const cT = Math.cos(tilt);
                const sT = Math.sin(tilt);
                const ty = ry * cT - rz * sT;
                const tz = ry * sT + rz * cT;
                ry = ty;
                rz = tz;

                let radialPulse = 1.0;
                let waveOsc = 0.0;
                
                if (currentVisualStatus === 'thinking') {
                    waveOsc = 0.08 * Math.sin(phi * 12.0 - time * 28.0);
                    radialPulse = 1.0 + 0.06 * Math.sin(time * 20.0);
                } else if (voiceIntensity > 0.01) {
                    // Reactive audio expansion
                    const voiceFactor = voiceIntensity;
                    // Base expansion based on intensity
                    radialPulse = 1.0 + voiceFactor * 0.15;
                    // Geometric wave based on sound peaks
                    const waveFreq = phi * 8.0 - time * 24.0 + lineID * 0.5;
                    waveOsc = voiceFactor * 0.12 * Math.sin(waveFreq);
                    
                    // Add bass jitter to radius
                    const bassJitter = peakIntensity > 0.3 ? (Math.random() - 0.5) * peakIntensity * 1.5 : 0;
                    radialPulse += bassJitter * 0.02;
                } else {
                    radialPulse = 1.0 + 0.04 * Math.sin(time * 1.6);
                    waveOsc = 0.02 * Math.sin(phi * 4.0 - time * 2.5);
                }

                const finalScale = radialPulse + waveOsc;
                rx *= finalScale;
                ry *= finalScale;
                rz *= finalScale;

            } else if (role === 3) {
                // Rings
                const ringIndex = (i - (coreCount + crustCount)) % 3;
                const ringSlot = i - (coreCount + crustCount);
                
                let rotSpeed = time * 0.85;
                if (ringIndex === 1) rotSpeed = -time * 0.95;
                else if (ringIndex === 2) rotSpeed = time * 1.15;
                
                const radius = 95;
                const baseAngle = ringBaseAngles[ringSlot];
                const ringAngle = baseAngle + rotSpeed;
                
                let ringPulse = 1.0;
                if (voiceIntensity > 0.02) {
                    ringPulse += voiceIntensity * 0.15 * Math.sin(ringAngle * 4.0 + time * 10.0);
                    ringPulse += peakIntensity * 0.1; // Expand on peaks
                }

                let ax = radius * Math.cos(ringAngle) * ringPulse;
                let ay = 0;
                let az = radius * Math.sin(ringAngle) * ringPulse;

                if (voiceIntensity > 0.01) {
                    const chaosFreq = time * 25.0 + i * 0.1;
                    const chaosAmp = voiceIntensity * 8.0;
                    ax += chaosAmp * Math.sin(chaosFreq * 1.3);
                    ay += chaosAmp * Math.cos(chaosFreq * 0.95);
                    az += chaosAmp * Math.sin(chaosFreq * 1.6);
                } else if (currentVisualStatus === 'thinking') {
                    const chaosFreq = time * 20.0 + i * 0.25;
                    ax += 3.2 * Math.sin(chaosFreq * 1.1);
                    ay += 3.2 * Math.cos(chaosFreq * 0.85);
                    az += 3.2 * Math.sin(chaosFreq * 1.4);
                }

                // Tilt the rings
                let tiltX = 0, tiltY = 0, tiltZ = 0;
                if (ringIndex === 0) {
                    tiltX = 35 * (Math.PI / 180);
                    tiltY = 20 * (Math.PI / 180);
                } else if (ringIndex === 1) {
                    tiltX = -35 * (Math.PI / 180);
                    tiltZ = 40 * (Math.PI / 180);
                } else {
                    tiltY = 70 * (Math.PI / 180);
                    tiltZ = -15 * (Math.PI / 180);
                }

                if (tiltX !== 0) {
                    const cosX = Math.cos(tiltX);
                    const sinX = Math.sin(tiltX);
                    const dy = ay * cosX - az * sinX;
                    const dz = ay * sinX + az * cosX;
                    ay = dy;
                    az = dz;
                }
                if (tiltY !== 0) {
                    const cosY = Math.cos(tiltY);
                    const sinY = Math.sin(tiltY);
                    const dx = ax * cosY + az * sinY;
                    const dz = -ax * sinY + az * cosY;
                    ax = dx;
                    az = dz;
                }
                if (tiltZ !== 0) {
                    const cosZ = Math.cos(tiltZ);
                    const sinZ = Math.sin(tiltZ);
                    const dx = ax * cosZ - ay * sinZ;
                    const dy = ax * sinZ + ay * cosZ;
                    ax = dx;
                    ay = dy;
                }

                rx = ax;
                ry = ay;
                rz = az;
            } else if (role === 2) {
                // Background atmosphere
                if (voiceIntensity > 0.02) {
                    const wavePhase = time * 20.0 - 8.0 + i * 0.02;
                    pulse = 1.0 + voiceIntensity * 0.08 * Math.sin(wavePhase);
                } else {
                    pulse = 1.0 + 0.03 * Math.sin(time * 1.2 + 1.6);
                }
            }

            const yElevation = 10.0;
            engine.positions[i3] = rx * pulse;
            engine.positions[i3 + 1] = ry * pulse + yElevation;
            engine.positions[i3 + 2] = rz * pulse;
            engine.targetPositions[i3] = rx * pulse;
            engine.targetPositions[i3 + 1] = ry * pulse + yElevation;
            engine.targetPositions[i3 + 2] = rz * pulse;
        }
    };
}}
