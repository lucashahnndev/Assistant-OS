{
    "name": "spotify.search",
    "description": "Busca conteúdo no Spotify (música, artista, álbum, playlist), com fallback quando credenciais não estiverem disponíveis.",
    "icon_key": "spotify",
    "icon_url": "https://open.spotify.com",
    "version": "1.0.0",
    "actions": {
        "search": {
            "description": "Pesquisa o catálogo do Spotify e retorna melhor resultado + lista estruturada.",
            "params": {
                "query": {
                    "type": "string",
                    "description": "Termo de busca"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "track",
                        "artist",
                        "album",
                        "playlist"
                    ],
                    "default": "track"
                },
                "market": {
                    "type": "string",
                    "description": "Código ISO do mercado (ex: BR)",
                    "default": "BR"
                },
                "limit": {
                    "type": "integer",
                    "default": 5
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "results": {
                        "type": "array"
                    },
                    "best": {
                        "type": "object"
                    },
                    "provider": {
                        "type": "string"
                    },
                    "confidenceScore": {
                        "type": "number"
                    }
                }
            }
        }
    },
    "config": {
        "auth": {
            "clientId": {
                "type": "string",
                "env": "SPOTIFY_CLIENT_ID"
            },
            "clientSecret": {
                "type": "string",
                "env": "SPOTIFY_CLIENT_SECRET"
            }
        },
        "defaults": {
            "market": {
                "type": "string",
                "default": "BR"
            },
            "limit": {
                "type": "integer",
                "default": 5
            }
        }
    }
}
