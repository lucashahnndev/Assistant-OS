{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "enabled": {
            "type": "boolean",
            "default": true,
            "title": "Enabled"
        },
        "timeout_sec": {
            "type": "integer",
            "default": 600,
            "minimum": 5,
            "maximum": 86400,
            "title": "Default Timeout (s)"
        },
        "max_timeout_sec": {
            "type": "integer",
            "default": 10800,
            "minimum": 30,
            "maximum": 86400,
            "title": "Max Timeout (s)"
        },
        "max_output_chars": {
            "type": "integer",
            "default": 120000,
            "minimum": 4000,
            "maximum": 1000000,
            "title": "Max Output Buffer (chars)"
        }
    }
}
