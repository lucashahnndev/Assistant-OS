{
    "name": "deezer.search",
    "description": "Encontra músicas, artistas, álbuns e playlists no Deezer, com retorno estruturado para recomendação e reprodução.",
    "icon_key": "deezer",
    "icon_url": "https://www.deezer.com",
    "version": "1.0.0",
    "actions": {
        "search": {
            "description": "Pesquisa catálogo do Deezer por tipo de conteúdo e retorna melhor correspondência + lista.",
            "params": {
                "query": {
                    "type": "string",
                    "description": "Termo de busca"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "track",
                        "artist",
                        "album",
                        "playlist"
                    ],
                    "default": "track"
                },
                "limit": {
                    "type": "integer",
                    "default": 5
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "results": {
                        "type": "array"
                    },
                    "best": {
                        "type": "object"
                    },
                    "provider": {
                        "type": "string"
                    },
                    "confidenceScore": {
                        "type": "number"
                    }
                }
            }
        }
    },
    "config": {
        "api": {
            "baseUrl": {
                "type": "string",
                "default": "https://api.deezer.com"
            }
        },
        "defaults": {
            "limit": {
                "type": "integer",
                "default": 5
            }
        }
    }
}
