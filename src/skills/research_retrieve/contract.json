{
  "name": "research.retrieve",
  "description": "Subagente de pesquisa web semi-isolado para busca, leitura e síntese com evidências.",
  "version": "1.0.0",
  "actions": {
    "run": {
      "description": "Executa pipeline de pesquisa web com budget rígido e retorno mitigado para o planner global.",
      "risk_level": "low",
      "params": {
        "query": {
          "type": "string",
          "description": "Consulta principal de pesquisa."
        },
        "goal": {
          "type": "string",
          "description": "Objetivo da tarefa (alias de query)."
        },
        "constraints": {
          "type": "object",
          "description": "Restrições de budget/escopo: lang, recency_days, domains_allow/deny, max_links_to_open, max_docs, max_total_chars, max_steps, extract_schema."
        },
        "output_format": {
          "type": "string",
          "enum": ["md", "toon"],
          "default": "md"
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "status": {"type": "string"},
          "answer_md": {"type": "string"},
          "toon": {"type": "string"},
          "sources": {"type": "array"},
          "evidence": {"type": "array"},
          "stats": {"type": "object"},
          "warnings": {"type": "array"},
          "error_code": {"type": ["string", "null"]},
          "error_message": {"type": ["string", "null"]},
          "retryable": {"type": "boolean"},
          "status_code": {"type": ["integer", "null"]},
          "elapsed_ms": {"type": "integer"}
        }
      },
      "examples": [
        {
          "input": {
            "query": "Compare top open-source vector databases for RAG in 2026",
            "constraints": {
              "lang": "en",
              "max_links_to_open": 3,
              "max_docs": 3,
              "max_total_chars": 10000,
              "max_steps": 7
            },
            "output_format": "md"
          }
        }
      ]
    }
  }
}
