{
    "name": "System Control",
    "description": "Operações de controle do sistema: status, processos, rede, serviços, arquivos, screenshot, teclado e energia.",
    "actions": [
        {
            "id": "system.control.info",
            "name": "info",
            "description": "Informações básicas do sistema (SO, data/hora e usuário)."
        },
        {
            "id": "system.control.time",
            "name": "time",
            "description": "Hora atual do sistema."
        },
        {
            "id": "system.control.status",
            "name": "status",
            "description": "Status de trabalhos ativos ou de um work_id específico.",
            "parameters": {
                "type": "object",
                "properties": {
                    "work_id": {
                        "type": "string",
                        "description": "Quando informado, retorna o status apenas desse trabalho."
                    }
                }
            }
        },
        {
            "id": "system.control.cancel",
            "name": "cancel",
            "description": "Solicita cancelamento de um trabalho ativo.",
            "parameters": {
                "type": "object",
                "properties": {
                    "work_id": {
                        "type": "string",
                        "description": "Identificador do trabalho a cancelar."
                    }
                },
                "required": ["work_id"]
            }
        },
        {
            "id": "system.control.screenshot",
            "name": "screenshot",
            "description": "Captura screenshot da tela atual.",
            "parameters": {
                "type": "object",
                "properties": {
                    "filename": {
                        "type": "string",
                        "description": "Nome do arquivo de saída. Padrão: screenshot.png."
                    },
                    "output_file": {
                        "type": "string",
                        "description": "Alias de filename."
                    }
                }
            }
        },
        {
            "id": "system.control.power",
            "name": "power",
            "description": "Executa ação de energia (reiniciar ou desligar).",
            "risk_level": "high",
            "parameters": {
                "type": "object",
                "properties": {
                    "action": {
                        "type": "string",
                        "description": "Ação de energia: reboot|restart|shutdown|off."
                    },
                    "command": {
                        "type": "string",
                        "description": "Alias legado de action."
                    }
                }
            }
        },
        {
            "id": "system.control.process.list",
            "name": "process.list",
            "description": "Lista processos em execução, com filtros.",
            "parameters": {
                "type": "object",
                "properties": {
                    "name_contains": {
                        "type": "string",
                        "description": "Filtra por trecho no nome do processo."
                    },
                    "user": {
                        "type": "string",
                        "description": "Filtra pelo usuário dono do processo."
                    },
                    "sort": {
                        "type": "string",
                        "description": "Ordenação: cpu ou mem.",
                        "default": "cpu"
                    }
                }
            }
        },
        {
            "id": "system.control.process.kill",
            "name": "process.kill",
            "description": "Finaliza processo pelo PID.",
            "risk_level": "high",
            "parameters": {
                "type": "object",
                "properties": {
                    "pid": {
                        "type": "integer",
                        "description": "PID do processo alvo."
                    },
                    "signal": {
                        "type": "string",
                        "description": "Nome do sinal (ex.: TERM).",
                        "default": "TERM"
                    }
                },
                "required": ["pid"]
            }
        },
        {
            "id": "system.control.network.status",
            "name": "network.status",
            "description": "Mostra status das interfaces de rede."
        },
        {
            "id": "system.control.network.ping",
            "name": "network.ping",
            "description": "Executa ping em um host/IP.",
            "parameters": {
                "type": "object",
                "properties": {
                    "host": {
                        "type": "string",
                        "description": "Host ou IP de destino."
                    },
                    "count": {
                        "type": "integer",
                        "description": "Quantidade de pacotes.",
                        "default": 4
                    }
                },
                "required": ["host"]
            }
        },
        {
            "id": "system.control.service.manage",
            "name": "service.manage",
            "description": "Gerencia serviços (status/start/stop/restart).",
            "risk_level": "high",
            "parameters": {
                "type": "object",
                "properties": {
                    "unit": {
                        "type": "string",
                        "description": "Unidade de serviço systemd."
                    },
                    "action": {
                        "type": "string",
                        "description": "Ação: status|start|stop|restart."
                    }
                },
                "required": ["unit", "action"]
            }
        },
        {
            "id": "system.control.service.logs",
            "name": "service.logs",
            "description": "Lê logs de um serviço systemd.",
            "parameters": {
                "type": "object",
                "properties": {
                    "unit": {
                        "type": "string",
                        "description": "Unidade de serviço systemd."
                    },
                    "lines": {
                        "type": "integer",
                        "description": "Quantidade de linhas de log.",
                        "default": 50
                    }
                },
                "required": ["unit"]
            }
        },
        {
            "id": "system.control.fs.list",
            "name": "fs.list",
            "description": "Lista arquivos e pastas de um diretório.",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "description": "Caminho do diretório relativo ao workspace.",
                        "default": "."
                    }
                }
            }
        },
        {
            "id": "system.control.fs.read",
            "name": "fs.read",
            "description": "Lê conteúdo de arquivo (com intervalo de linhas opcional).",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "description": "Caminho do arquivo relativo ao workspace."
                    },
                    "start": {
                        "type": "integer",
                        "description": "Linha inicial (1-indexado).",
                        "default": 1
                    },
                    "end": {
                        "type": "integer",
                        "description": "Linha final (inclusiva)."
                    }
                },
                "required": ["path"]
            }
        },
        {
            "id": "system.control.fs.write",
            "name": "fs.write",
            "description": "Escreve conteúdo em arquivo no workspace.",
            "risk_level": "high",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "description": "Caminho do arquivo relativo ao workspace."
                    },
                    "content": {
                        "type": "string",
                        "description": "Conteúdo a ser escrito."
                    }
                },
                "required": ["path", "content"]
            }
        },
        {
            "id": "system.control.fs.delete",
            "name": "fs.delete",
            "description": "Remove arquivo ou diretório no workspace.",
            "risk_level": "high",
            "parameters": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "description": "Caminho do arquivo/diretório relativo ao workspace."
                    }
                },
                "required": ["path"]
            }
        },
        {
            "id": "system.control.keyboard",
            "name": "keyboard",
            "description": "Executa comandos globais de teclado/mídia.",
            "parameters": {
                "type": "object",
                "properties": {
                    "action": {
                        "type": "string",
                        "description": "One of: next, prev, pause, volume_up, volume_down, mute, close."
                    },
                    "command": {
                        "type": "string",
                        "description": "Comando textual legado (compatibilidade)."
                    }
                }
            }
        }
    ]
}
