{
    "name": "weather.control",
    "description": "Consulta clima atual e previsão por cidade/coordenadas, com fallback automático.",
    "version": "1.0.0",
    "actions": {
        "get": {
            "description": "Obtém o clima atual para cidade/localização/coordenadas.",
            "risk_level": "low",
            "params": {
                "city": {
                    "type": "string",
                    "description": "Nome da cidade."
                },
                "location": {
                    "type": "string",
                    "description": "Alias de city."
                },
                "lat": {
                    "type": "number",
                    "description": "Latitude."
                },
                "lon": {
                    "type": "number",
                    "description": "Longitude."
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    },
                    "status": {
                        "type": "string"
                    },
                    "provider": {
                        "type": "string"
                    },
                    "location": {
                        "type": "string"
                    },
                    "current": {
                        "type": "object"
                    }
                }
            }
        },
        "forecast": {
            "description": "Obtém previsão de 1 a 5 dias para cidade/localização/coordenadas.",
            "risk_level": "low",
            "params": {
                "city": {
                    "type": "string",
                    "description": "Nome da cidade."
                },
                "location": {
                    "type": "string",
                    "description": "Alias de city."
                },
                "lat": {
                    "type": "number",
                    "description": "Latitude."
                },
                "lon": {
                    "type": "number",
                    "description": "Longitude."
                },
                "days": {
                    "type": "integer",
                    "description": "Quantidade de dias (1-5).",
                    "default": 3
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    },
                    "status": {
                        "type": "string"
                    },
                    "provider": {
                        "type": "string"
                    },
                    "location": {
                        "type": "string"
                    },
                    "days": {
                        "type": "integer"
                    },
                    "forecast": {
                        "type": "array"
                    }
                }
            }
        }
    },
    "config": {
        "api_key": {
            "type": "string",
            "env": "WEATHER_API_KEY"
        },
        "defaults": {
            "days": {
                "type": "integer",
                "default": 3
            }
        }
    }
}
