{
    "name": "Weather Control",
    "description": "Consulta clima atual e previsão por cidade/coordenadas, com fallback automático quando necessário.",
    "actions": [
        {
            "id": "weather.control.get",
            "name": "get",
            "description": "Obtém o clima atual para cidade/localização/coordenadas.",
            "parameters": {
                "type": "object",
                "properties": {
                    "city": {
                        "type": "string",
                        "description": "Nome da cidade."
                    },
                    "location": {
                        "type": "string",
                        "description": "Alias de city."
                    },
                    "lat": {
                        "type": "number",
                        "description": "Latitude."
                    },
                    "lon": {
                        "type": "number",
                        "description": "Longitude."
                    }
                }
            }
        },
        {
            "id": "weather.control.forecast",
            "name": "forecast",
            "description": "Obtém previsão de 1 a 5 dias para cidade/localização/coordenadas.",
            "parameters": {
                "type": "object",
                "properties": {
                    "city": {
                        "type": "string",
                        "description": "Nome da cidade."
                    },
                    "location": {
                        "type": "string",
                        "description": "Alias de city."
                    },
                    "lat": {
                        "type": "number",
                        "description": "Latitude."
                    },
                    "lon": {
                        "type": "number",
                        "description": "Longitude."
                    },
                    "days": {
                        "type": "integer",
                        "description": "Quantidade de dias (1-5).",
                        "default": 3
                    }
                }
            }
        }
    ]
}
