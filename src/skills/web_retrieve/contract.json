{
  "name": "web.retrieve",
  "description": "Retrieval web determinístico para RAG: leitura robusta e extração estruturada sem LLM.",
  "version": "1.0.0",
  "actions": {
    "read": {
      "description": "Lê uma URL e extrai texto limpo em markdown/text para ingestão RAG.",
      "risk_level": "low",
      "params": {
        "url": {
          "type": "string",
          "description": "URL completa (http/https)."
        },
        "max_chars": {
          "type": "integer",
          "default": 12000
        },
        "mode": {
          "type": "string",
          "enum": ["auto", "main", "all"],
          "default": "auto"
        },
        "timeout_ms": {
          "type": "integer",
          "default": 10000
        },
        "retries": {
          "type": "integer",
          "default": 1
        },
        "chunk_size": {
          "type": "integer",
          "default": 700
        },
        "chunk_overlap": {
          "type": "integer",
          "default": 100
        },
        "telemetry_enabled": {
          "type": "boolean",
          "default": false
        },
        "telemetry_level": {
          "type": "string",
          "enum": ["basic", "verbose"],
          "default": "basic"
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "status": {"type": "string"},
          "provider": {"type": "string"},
          "url": {"type": "string"},
          "canonical_url": {"type": "string"},
          "title": {"type": "string"},
          "status_code": {"type": "integer"},
          "content_type": {"type": "string"},
          "elapsed_ms": {"type": "integer"},
          "error_code": {"type": ["string", "null"]},
          "error_message": {"type": ["string", "null"]},
          "retryable": {"type": "boolean"},
          "text_md": {"type": "string"},
          "language": {"type": "string"},
          "chunks": {"type": "array"},
          "warnings": {"type": "array"}
        }
      },
      "examples": [
        {
          "input": {
            "url": "https://example.com/article",
            "mode": "main",
            "max_chars": 6000
          }
        }
      ]
    },
    "extract": {
      "description": "Extrai campos estruturados de HTML via schema de seletores/regex.",
      "risk_level": "low",
      "params": {
        "url": {
          "type": "string",
          "description": "URL completa (http/https)."
        },
        "schema": {
          "type": "array",
          "description": "Lista de campos com name + selector/regex/attr/required."
        },
        "max_chars": {
          "type": "integer",
          "default": 12000
        },
        "timeout_ms": {
          "type": "integer",
          "default": 10000
        },
        "retries": {
          "type": "integer",
          "default": 1
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "status": {"type": "string"},
          "provider": {"type": "string"},
          "url": {"type": "string"},
          "canonical_url": {"type": "string"},
          "title": {"type": "string"},
          "status_code": {"type": "integer"},
          "elapsed_ms": {"type": "integer"},
          "error_code": {"type": ["string", "null"]},
          "error_message": {"type": ["string", "null"]},
          "retryable": {"type": "boolean"},
          "data": {"type": "object"},
          "warnings": {"type": "array"}
        }
      },
      "examples": [
        {
          "input": {
            "url": "https://example.com/article",
            "schema": [
              {"name": "headline", "selector": "h1", "required": true},
              {"name": "author", "selector": ".author", "required": false}
            ]
          }
        }
      ]
    }
  },
  "config": {
    "defaults": {
      "timeout_ms": {"type": "integer", "default": 10000},
      "connect_timeout_ms": {"type": "integer", "default": 10000},
      "read_timeout_ms": {"type": "integer", "default": 10000},
      "retries": {"type": "integer", "default": 1},
      "max_chars": {"type": "integer", "default": 12000},
      "max_bytes": {"type": "integer", "default": 2000000},
      "strip_tracking_params": {"type": "boolean", "default": true},
      "respect_robots": {"type": "boolean", "default": false},
      "rate_limit_per_host": {"type": "number", "default": 0},
      "cache_ttl_sec": {"type": "integer", "default": 0},
      "chunk_size": {"type": "integer", "default": 700},
      "chunk_overlap": {"type": "integer", "default": 100}
    }
  }
}
