{
    "name": "web.search",
    "description": "Busca informações na web com modo de links ou extração de conhecimento estruturado para contexto da IA.",
    "version": "1.0.0",
    "actions": {
        "discover": {
            "description": "Pesquisa web por tema e devolve links relevantes. Também pode extrair conteúdo textual em formato RAG.",
            "risk_level": "low",
            "params": {
                "query": {
                    "type": "string",
                    "description": "Termo de busca"
                },
                "limit": {
                    "type": "integer",
                    "default": 5
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "links",
                        "knowledge",
                        "auto"
                    ],
                    "default": "links",
                    "description": "links: retorna links estruturados. knowledge: extrai conteúdo textual dos principais links. auto: alias de links."
                },
                "knowledge_limit": {
                    "type": "integer",
                    "default": 2,
                    "description": "Quantidade de links (top resultados) usados na extração de conteúdo em modo knowledge."
                },
                "max_chars_per_doc": {
                    "type": "integer",
                    "default": 2500,
                    "description": "Limite de caracteres extraídos por documento."
                },
                "chunk_size": {
                    "type": "integer",
                    "default": 700,
                    "description": "Tamanho de cada chunk textual para RAG."
                },
                "chunk_overlap": {
                    "type": "integer",
                    "default": 100,
                    "description": "Sobreposição entre chunks para preservar contexto."
                },
                "domains_allow": {
                    "type": "array",
                    "description": "Whitelist de domínios permitidos (post-filter obrigatório)."
                },
                "domains_deny": {
                    "type": "array",
                    "description": "Blacklist de domínios negados (post-filter obrigatório)."
                },
                "recency_days": {
                    "type": "integer",
                    "default": 0,
                    "description": "Janela de recência quando suportada pelo provider; fallback best-effort com warning."
                },
                "language": {
                    "type": "string",
                    "description": "Idioma preferido para a busca (ex.: pt-BR, en-US)."
                },
                "location": {
                    "type": "object",
                    "description": "Geolocalização contextual da aplicação web (city/state/country/lat/lon)."
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    },
                    "status": {
                        "type": "string"
                    },
                    "results": {
                        "type": "array"
                    },
                    "best": {
                        "type": "object"
                    },
                    "count": {
                        "type": "integer"
                    },
                    "mode": {
                        "type": "string"
                    },
                    "knowledge_docs": {
                        "type": "array"
                    },
                    "chunks": {
                        "type": "array"
                    },
                    "warnings": {
                        "type": "array"
                    },
                    "provider": {
                        "type": "string"
                    },
                    "providers_tried": {
                        "type": "array"
                    },
                    "language": {
                        "type": "string"
                    },
                    "location": {
                        "type": ["object", "null"]
                    },
                    "error_code": {
                        "type": ["string", "null"]
                    },
                    "error_message": {
                        "type": ["string", "null"]
                    },
                    "retryable": {
                        "type": "boolean"
                    },
                    "status_code": {
                        "type": ["integer", "null"]
                    },
                    "elapsed_ms": {
                        "type": "integer"
                    }
                }
            }
        }
    },
    "config": {
        "provider": {
            "type": "string",
            "default": "search_router"
        },
        "defaults": {
            "limit": {
                "type": "integer",
                "default": 5
            },
            "mode": {
                "type": "string",
                "default": "links"
            },
            "knowledge_limit": {
                "type": "integer",
                "default": 2
            },
            "max_chars_per_doc": {
                "type": "integer",
                "default": 2500
            },
            "chunk_size": {
                "type": "integer",
                "default": 700
            },
            "chunk_overlap": {
                "type": "integer",
                "default": 100
            },
            "timeout_ms": {
                "type": "integer",
                "default": 5000
            },
            "retries": {
                "type": "integer",
                "default": 1
            }
        },
        "search_router": {
            "type": "object",
            "description": "Configuração do router de providers sem API key.",
            "properties": {
                "provider_order": {"type": "array"},
                "timeout_ms": {"type": "integer", "default": 5000},
                "retries": {"type": "integer", "default": 1},
                "providers": {
                    "type": "object",
                    "properties": {
                        "searxng": {"type": "object"},
                        "commoncrawl": {"type": "object"},
                        "openalex": {"type": "object"},
                        "ddg": {"type": "object"}
                    }
                }
            }
        }
    }
}
