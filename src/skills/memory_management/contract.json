{
    "name": "Memory",
    "description": "Memória persistente do agente para armazenar e recuperar fatos relevantes do usuário e do contexto.",
    "actions": [
        {
            "id": "memory.recall",
            "handler": "recall",
            "description": "Busca informações já registradas na memória persistente.",
            "parameters": {
                "properties": {
                    "query": {
                        "type": "string"
                    }
                },
                "required": [
                    "query"
                ]
            }
        },
        {
            "id": "memory.store",
            "handler": "store",
            "description": "Armazena um novo fato na memória persistente.",
            "parameters": {
                "properties": {
                    "content": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string",
                        "default": "general"
                    }
                },
                "required": [
                    "content"
                ]
            }
        }
    ]
}
