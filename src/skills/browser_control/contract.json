{
    "name": "browser.control",
    "description": "Abre e controla um navegador real (Chrome) via CDP. USE ESTA SKILL quando o usuário pedir para ABRIR o navegador, NAVEGAR em sites, CLICAR em elementos, PREENCHER formulários, ou realizar qualquer INTERAÇÃO VISUAL com páginas web. NÃO use web.search ou web.retrieve para esses casos.",
    "icon_key": "browser",
    "icon_url": "https://www.chromium.org",
    "version": "1.0.0",
    "actions": {
        "run": {
            "description": "Abre o Chrome e executa uma tarefa completa no navegador: navegar, pesquisar, clicar, interagir com páginas. O campo 'goal' pode ficar vazio; nesse caso, o texto original do usuário será usado como objetivo.",
            "risk_level": "medium",
            "params": {
                "goal": {
                    "type": "string",
                    "description": "Objetivo a ser atingido no navegador (ex: 'abra o google e pesquise sobre foguetes'). Se vazio, usa o input do usuário."
                },
                "headless": {
                    "type": "boolean",
                    "description": "Se true, abre o navegador em modo invisível (sem janela). Padrão: false (com janela visível).",
                    "required": false
                },
                "muted": {
                    "type": "boolean",
                    "description": "Se true, abre o navegador sem som. Use quando o usuário pedir silêncio ou quando o som não for relevante. Padrão: false (com som).",
                    "required": false
                },
                "intent_class": {
                    "type": "string",
                    "description": "Classe de intenção de navegação para política interna de sessão/abas. Valores suportados: controlar_midia, realizar_pesquisa, automacao_ui, validacao_visual, manutencao.",
                    "enum": ["controlar_midia", "realizar_pesquisa", "automacao_ui", "validacao_visual", "manutencao"],
                    "required": true
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    },
                    "result": {
                        "type": "object"
                    },
                    "execution_context": {
                        "type": "object"
                    },
                    "registry_snapshot": {
                        "type": "object"
                    },
                    "metadata": {
                        "type": "object",
                        "description": "Metadados operacionais da execução (ex.: registry_gc, media_singleton_cleanup). Em step, inclui continuation com reattach_to_tab/target_recovery."
                    },
                    "error": {
                        "type": "string"
                    }
                }
            }
        },
        "step": {
            "description": "Executa uma única instrução no navegador já aberto (ex: 'clique no botão login').",
            "risk_level": "medium",
            "params": {
                "instruction": {
                    "type": "string",
                    "description": "Instrução específica (ex: 'clique no botão login')."
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    },
                    "result": {
                        "type": "object"
                    },
                    "execution_context": {
                        "type": "object"
                    },
                    "registry_snapshot": {
                        "type": "object"
                    },
                    "metadata": {
                        "type": "object",
                        "description": "Metadados operacionais da execução. Em step, inclui continuation com reattach_to_tab/target_recovery."
                    },
                    "error": {
                        "type": "string"
                    }
                }
            }
        },
        "close": {
            "description": "Fecha a instância do navegador.",
            "risk_level": "low",
            "params": {},
            "output": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean"
                    }
                }
            }
        },
        "inspect": {
            "description": "Lista inventário de instâncias/abas de browser registradas globalmente (com opção de filtrar por sessão).",
            "risk_level": "low",
            "params": {
                "session_id": {
                    "type": "string",
                    "description": "Filtra por sessão dona da instância.",
                    "required": false
                },
                "only_current_session": {
                    "type": "boolean",
                    "description": "Quando true, usa a sessão atual do contexto para filtrar automaticamente.",
                    "required": false
                },
                "include_tabs": {
                    "type": "boolean",
                    "description": "Inclui abas no retorno.",
                    "required": false
                },
                "include_last_vision": {
                    "type": "boolean",
                    "description": "Inclui a última observação visual normalizada da execução corrente.",
                    "required": false
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "ok": { "type": "boolean" },
                    "instances": { "type": "array" },
                    "count": { "type": "number" }
                }
            }
        },
        "close_tab": {
            "description": "Fecha uma aba registrada por tab_id. Se for a aba ativa da instância corrente, encerra o runtime associado.",
            "risk_level": "medium",
            "params": {
                "tab_id": {
                    "type": "string",
                    "description": "ID da aba no registry.",
                    "required": true
                },
                "force": {
                    "type": "boolean",
                    "description": "Quando true, ignora bloqueios de ownership/in_use para fechamento administrativo.",
                    "required": false
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "ok": { "type": "boolean" },
                    "closed_tab_id": { "type": "string" },
                    "instance_id": { "type": "string" }
                }
            }
        },
        "close_instance": {
            "description": "Fecha uma instância de navegador por instance_id.",
            "risk_level": "medium",
            "params": {
                "instance_id": {
                    "type": "string",
                    "description": "ID da instância no registry.",
                    "required": true
                },
                "force": {
                    "type": "boolean",
                    "description": "Quando true, ignora bloqueios de ownership/in_use para fechamento administrativo.",
                    "required": false
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "ok": { "type": "boolean" },
                    "closed_instance_id": { "type": "string" }
                }
            }
        },
        "sync_registry": {
            "description": "Sincroniza estado de runtime ativo com o registry global (instância/aba/porta).",
            "risk_level": "low",
            "params": {},
            "output": {
                "type": "object",
                "properties": {
                    "ok": { "type": "boolean" },
                    "browser_instance_id": { "type": "string" },
                    "tab_id": { "type": "string" },
                    "debug_port": { "type": "number" },
                    "cdp_target_id": { "type": "string" },
                    "registry_snapshot": { "type": "object" },
                    "last_vision_observation": { "type": "object" }
                }
            }
        },
        "gc": {
            "description": "Executa garbage collection administrativo do registry de browser (locks expirados e instâncias ociosas).",
            "risk_level": "low",
            "params": {
                "idle_seconds": {
                    "type": "number",
                    "description": "Tempo mínimo de ociosidade para fechar instâncias ativas sem uso.",
                    "required": false
                },
                "keep_current_instance": {
                    "type": "boolean",
                    "description": "Quando true, preserva a instância atual da skill durante o GC.",
                    "required": false
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "ok": { "type": "boolean" },
                    "gc": { "type": "object" },
                    "registry_snapshot": { "type": "object" }
                }
            }
        },
        "health": {
            "description": "Executa diagnóstico consolidado da skill (inspect + sync_registry + opcionalmente gc).",
            "risk_level": "low",
            "params": {
                "run_gc": {
                    "type": "boolean",
                    "description": "Quando true, executa GC junto do diagnóstico.",
                    "required": false
                },
                "include_tabs": {
                    "type": "boolean",
                    "description": "Inclui abas no bloco inspect.",
                    "required": false
                },
                "include_last_vision": {
                    "type": "boolean",
                    "description": "Inclui última visão no bloco inspect.",
                    "required": false
                },
                "only_current_session": {
                    "type": "boolean",
                    "description": "Filtra diagnóstico para a sessão atual.",
                    "required": false
                },
                "gc_params": {
                    "type": "object",
                    "description": "Parâmetros opcionais repassados para browser.control.gc.",
                    "required": false
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "ok": { "type": "boolean" },
                    "health": { "type": "object" },
                    "inspect": { "type": "object" },
                    "sync": { "type": "object" },
                    "gc": { "type": "object" },
                    "registry_snapshot": { "type": "object" }
                }
            }
        }
    }
}
