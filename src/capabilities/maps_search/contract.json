{
  "contract_version": "1.0",
  "capability": {
    "id": "maps_search",
    "namespace": "maps.search",
    "version": "1.0.0",
    "title": "maps.search",
    "description": "Busca locais no Google Maps com suporte a cidade, categorias e modo diversificado de resultados.",
    "assets": {
      "icon_svg": "assets/icon.svg"
    }
  },
  "runtime": {
    "module": "capabilities.maps_search",
    "factory": "create_capability",
    "config_schema": "./config.schema.json"
  },
  "actions": [
    {
      "id": "maps.search.search",
      "title": "Search",
      "description": "Pesquisa lugares por texto/categoria/cidade, com filtros e opção de variações automáticas para ampliar resultados.",
      "handler": "search",
      "risk_level": "low",
      "permissions": {
        "scopes": [
          "maps:search:search"
        ],
        "allow_anyone": true,
        "requires_approval": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Consulta livre (ex.: 'restaurantes japoneses'). Se city for informado, a capability complementa automaticamente."
          },
          "city": {
            "type": "string",
            "description": "Cidade alvo da busca (ex.: 'Curitiba')."
          },
          "category": {
            "type": "string",
            "description": "Categoria de local para compor a consulta (ex.: restaurante, farmácia, hotel)."
          },
          "keywords": {
            "type": "string",
            "description": "Palavras-chave extras (ex.: 'vegano', '24h', 'com estacionamento')."
          },
          "near": {
            "type": "string",
            "description": "Ponto para bias geográfico. Aceita 'lat,lng' ou texto geocodificável."
          },
          "radius": {
            "type": "integer",
            "description": "Raio em metros para busca com localização.",
            "default": 5000
          },
          "type": {
            "type": "string",
            "description": "Tipo oficial do Places API (ex.: restaurant, hospital)."
          },
          "place_type": {
            "type": "string",
            "description": "Alias de category para compor consulta semântica."
          },
          "open_now": {
            "type": "boolean",
            "description": "Quando true, prioriza locais abertos no momento.",
            "default": false
          },
          "min_rating": {
            "type": "number",
            "description": "Nota mínima (0 a 5).",
            "default": 0
          },
          "sort_by": {
            "type": "string",
            "enum": [
              "relevance",
              "rating"
            ],
            "description": "Critério de ordenação.",
            "default": "relevance"
          },
          "limit": {
            "type": "integer",
            "description": "Quantidade máxima de resultados finais.",
            "default": 8
          },
          "mode": {
            "type": "string",
            "enum": [
              "standard",
              "diverse"
            ],
            "description": "No modo 'diverse' executa variações de consulta para ampliar cobertura.",
            "default": "standard"
          },
          "diversify": {
            "type": "boolean",
            "description": "Alias rápido para ativar mode='diverse'.",
            "default": false
          },
          "max_variants": {
            "type": "integer",
            "description": "Número máximo de variações de consulta no modo diversificado.",
            "default": 3
          }
        },
        "additionalProperties": true
      },
      "side_effect": "none"
    }
  ],
  "retrieval_profile": {
    "enabled": true,
    "roles": [
      "search",
      "structured_entity"
    ],
    "domains": [
      "location",
      "maps"
    ],
    "entity_types": [
      "place",
      "business",
      "point_of_interest"
    ],
    "freshness": {
      "type": "live",
      "sla_hours": 24
    },
    "quality": {
      "default_confidence": 0.78,
      "trust_tier": "public_api",
      "citation_mode": "url_required"
    },
    "cost": {
      "latency_class": "medium",
      "quota_class": "metered"
    },
    "setup": {
      "requires_auth": true,
      "required_fields": [
        "apiKey"
      ],
      "healthcheck_action": "maps.search.search"
    },
    "output_contract": {
      "evidence_schema": "external.evidence.v1",
      "entity_schema": "external.entity.v1"
    },
    "routing_hints": {
      "preferred_intents": [
        "location_lookup"
      ],
      "avoid_when": [
        "music_lookup",
        "policy_lookup"
      ]
    }
  },
  "auth": {
    "mode": "api_key",
    "required": true,
    "fields": [
      {
        "id": "apikey",
        "type": "secret_ref",
        "config_path": "apiKey",
        "required": true,
        "title": "Google Maps API Key",
        "secret_policy": {
          "allow_create": true,
          "allow_select": true
        }
      }
    ]
  },
  "discoverability_profile": {
    "enabled": true,
    "roles": [
      "search",
      "structured_entity"
    ],
    "domains": [
      "location",
      "maps"
    ],
    "entity_types": [
      "place",
      "business",
      "point_of_interest"
    ],
    "keywords": [
      "maps_search",
      "maps",
      "search",
      "busca",
      "locais",
      "google",
      "com",
      "suporte",
      "cidade",
      "categorias",
      "modo",
      "diversificado",
      "resultados",
      "discover",
      "consult",
      "discoverability",
      "retrieve",
      "control",
      "interact",
      "manage"
    ],
    "routing_hints": {
      "preferred_intents": [
        "location_lookup"
      ],
      "avoid_when": [
        "music_lookup",
        "policy_lookup"
      ]
    }
  }
}
