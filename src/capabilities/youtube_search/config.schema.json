{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "title": "Enabled"
    },
    "authSource": {
      "type": "string",
      "title": "YouTube authentication source",
      "enum": [
        "auto",
        "linked_account",
        "api_key"
      ],
      "default": "auto",
      "description": "Choose whether this capability should prefer a linked Google account, use only API key, or automatically prefer linked account and fallback to API key.",
      "x-ui": {
        "widget": "select"
      }
    },
    "apiKey": {
      "type": "string",
      "title": "YouTube Data API Key",
      "x-ui": {
        "placeholder": "GOOGLE_YOUTUBE_API_KEY"
      }
    },
    "defaults": {
      "type": "object",
      "title": "Defaults",
      "properties": {
        "limit": {
          "type": "integer",
          "title": "Default Limit",
          "default": 5
        },
        "surfaceMode": {
          "type": "string",
          "title": "Default Surface",
          "enum": [
            "auto",
            "youtube",
            "music"
          ],
          "default": "auto",
          "x-ui": {
            "widget": "select"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
