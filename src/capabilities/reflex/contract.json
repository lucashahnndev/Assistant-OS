{
  "contract_version": "1.0",
  "capability": {
    "id": "reflex",
    "namespace": "reflex",
    "version": "1.0.0",
    "title": "Reflex",
    "description": "Reflex control commands for status and cancellation operations."
  },
  "runtime": {
    "module": "capabilities.reflex",
    "factory": "create_capability"
  },
  "actions": [
    {
      "id": "reflex.status",
