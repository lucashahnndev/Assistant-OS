{
  "contract_version": "1.0",
  "capability": {
    "id": "youtube_retrieve",
    "namespace": "youtube",
    "version": "1.0.0",
    "title": "youtube",
    "description": "Recupera metadados de v\u00eddeo do YouTube e transcript opcional sem LLM."
  },
  "runtime": {
    "module": "capabilities.youtube_retrieve",
    "factory": "create_capability",
    "config_schema": "./config.schema.json"
  },
  "actions": [
    {
      "id": "youtube.retrieve.get",
      "title": "Get",
      "description": "Obt\u00e9m metadados de v\u00eddeo (e transcript opcional) usando yt-dlp.",
      "handler": "retrieve.get",
      "risk_level": "low",
      "permissions": {
        "scopes": [
          "youtube:retrieve:get"
        ],
        "allow_anyone": true,
        "requires_approval": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "URL do v\u00eddeo no YouTube."
          },
          "video_id": {
            "type": "string",
            "description": "ID do v\u00eddeo (alternativa a url)."
          },
          "include_transcript": {
            "type": "boolean",
            "default": false
          },
          "max_chars": {
            "type": "integer",
            "default": 12000
          },
          "transcript_timeout_ms": {
            "type": "integer",
            "default": 8000
          }
        },
        "additionalProperties": true
      },
      "examples": [
        {
          "input": {
            "video_id": "dQw4w9WgXcQ",
            "include_transcript": true,
            "max_chars": 5000
          }
        }
      ],
      "side_effect": "none"
    }
  ],
  "auth": {
    "mode": "hybrid",
    "required": false,
    "source_config_path": "authSource",
    "default_source": "auto",
    "sources": [
      {
        "id": "auto",
        "type": "strategy",
        "title": "Automatic",
        "description": "Prefer linked Google account and fallback to API key when available."
      },
      {
        "id": "linked_account",
        "type": "oauth_account",
        "title": "Linked Google Account Only",
        "description": "Use only a connected Google account for this capability.",
        "provider": "google"
      },
      {
        "id": "api_key",
        "type": "secret_ref",
        "title": "API Key Only",
        "description": "Use only the configured API key for this capability.",
        "field_id": "apikey"
      }
    ],
    "fields": [
      {
        "id": "apikey",
        "type": "secret_ref",
        "config_path": "apiKey",
        "required": false,
        "title": "YouTube Data API Key",
        "secret_policy": {
          "allow_create": true,
          "allow_select": true
        }
      }
    ]
  }
}
