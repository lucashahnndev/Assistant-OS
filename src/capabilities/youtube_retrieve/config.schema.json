{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "title": "Enabled"
    },
    "authSource": {
      "type": "string",
      "title": "YouTube authentication source",
      "enum": [
        "auto",
        "linked_account",
        "api_key"
      ],
      "default": "auto",
      "description": "Choose whether this capability should prefer a linked Google account, use only API key, or automatically prefer linked account and fallback to API key.",
      "x-ui": {
        "widget": "select"
      }
    },
    "apiKey": {
      "type": "string",
      "title": "YouTube Data API Key",
      "x-ui": {
        "placeholder": "GOOGLE_YOUTUBE_API_KEY"
      }
    },
    "defaults": {
      "type": "object",
      "title": "Defaults",
      "properties": {
        "include_transcript": {
          "type": "boolean",
          "title": "Include Transcript by Default",
          "default": false
        },
        "max_chars": {
          "type": "integer",
          "title": "Default Max Characters",
          "default": 12000
        },
        "transcript_timeout_ms": {
          "type": "integer",
          "title": "Transcript Timeout (ms)",
          "default": 8000
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
