{
  "contract_version": "1.0",
  "capability": {
    "id": "web_retrieve",
    "namespace": "web.retrieve",
    "version": "1.0.0",
    "title": "web.retrieve",
    "description": "Retrieval web determinístico para RAG: leitura robusta e extração estruturada sem LLM."
  },
  "runtime": {
    "module": "capabilities.web_retrieve",
    "factory": "create_capability",
    "config_schema": "./config.schema.json"
  },
  "actions": [
    {
      "id": "web.retrieve.read",
      "title": "Read",
      "description": "Lê uma URL e extrai texto limpo em markdown/text para ingestão RAG.",
      "handler": "read",
      "risk_level": "low",
      "permissions": {
        "scopes": [
          "web:retrieve:read"
        ],
        "allow_anyone": true,
        "requires_approval": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "URL completa (http/https)."
          },
          "max_chars": {
            "type": "integer",
            "default": 12000
          },
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "main",
              "all"
            ],
            "default": "auto"
          },
          "timeout_ms": {
            "type": "integer",
            "default": 10000
          },
          "retries": {
            "type": "integer",
            "default": 1
          },
          "chunk_size": {
            "type": "integer",
            "default": 700
          },
          "chunk_overlap": {
            "type": "integer",
            "default": 100
          },
          "telemetry_enabled": {
            "type": "boolean",
            "default": false
          },
          "telemetry_level": {
            "type": "string",
            "enum": [
              "basic",
              "verbose"
            ],
            "default": "basic"
          }
        },
        "additionalProperties": true
      },
      "examples": [
        {
          "input": {
            "url": "https://example.com/article",
            "mode": "main",
            "max_chars": 6000
          }
        }
      ],
      "side_effect": "none"
    },
    {
      "id": "web.retrieve.extract",
      "title": "Extract",
      "description": "Extrai campos estruturados de HTML via schema de seletores/regex.",
      "handler": "extract",
      "risk_level": "low",
      "permissions": {
        "scopes": [
          "web:retrieve:extract"
        ],
        "allow_anyone": true,
        "requires_approval": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "URL completa (http/https)."
          },
          "schema": {
            "type": "array",
            "description": "Lista de campos com name + selector/regex/attr/required."
          },
          "max_chars": {
            "type": "integer",
            "default": 12000
          },
          "timeout_ms": {
            "type": "integer",
            "default": 10000
          },
          "retries": {
            "type": "integer",
            "default": 1
          }
        },
        "additionalProperties": true
      },
      "examples": [
        {
          "input": {
            "url": "https://example.com/article",
            "schema": [
              {
                "name": "headline",
                "selector": "h1",
                "required": true
              },
              {
                "name": "author",
                "selector": ".author",
                "required": false
              }
            ]
          }
        }
      ],
      "side_effect": "none"
    }
  ],
  "auth": {
    "mode": "none",
    "required": false,
    "fields": []
  }
}
