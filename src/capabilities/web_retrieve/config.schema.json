{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "title": "Enabled"
    },
    "defaults": {
      "type": "object",
      "title": "Defaults",
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "default": 10000
        },
        "connect_timeout_ms": {
          "type": "integer",
          "default": 10000
        },
        "read_timeout_ms": {
          "type": "integer",
          "default": 10000
        },
        "retries": {
          "type": "integer",
          "default": 1
        },
        "max_chars": {
          "type": "integer",
          "default": 12000
        },
        "max_bytes": {
          "type": "integer",
          "default": 2000000
        },
        "strip_tracking_params": {
          "type": "boolean",
          "default": true
        },
        "respect_robots": {
          "type": "boolean",
          "default": false
        },
        "rate_limit_per_host": {
          "type": "number",
          "default": 0
        },
        "cache_ttl_sec": {
          "type": "integer",
          "default": 0
        },
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "main",
            "all"
          ],
          "default": "auto",
          "x-ui": {
            "widget": "select"
          }
        },
        "telemetry_enabled": {
          "type": "boolean",
          "default": false
        },
        "telemetry_level": {
          "type": "string",
          "enum": [
            "basic",
            "verbose"
          ],
          "default": "basic",
          "x-ui": {
            "widget": "select"
          }
        },
        "chunk_size": {
          "type": "integer",
          "default": 700
        },
        "chunk_overlap": {
          "type": "integer",
          "default": 100
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
