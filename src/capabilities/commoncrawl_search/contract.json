{
  "contract_version": "1.0",
  "capability": {
    "id": "commoncrawl_search",
    "namespace": "commoncrawl.search",
    "version": "1.0.0",
    "title": "commoncrawl.search",
    "description": "Busca web por índices Common Crawl para RAG externo.",
    "assets": {
      "icon_svg": "assets/icon.svg"
    }
  },
  "runtime": {
    "module": "capabilities.commoncrawl_search",
    "factory": "create_capability",
    "config_schema": "./config.schema.json"
  },
  "actions": [
    {
      "id": "commoncrawl.search.query",
      "title": "Query",
      "description": "Executa busca por URLs candidatas no Common Crawl CDX.",
      "handler": "query",
      "risk_level": "low",
      "permissions": {
        "scopes": ["commoncrawl:search:query"],
        "allow_anyone": true,
        "requires_approval": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "limit": { "type": "integer", "default": 6 },
          "recency_days": { "type": "integer", "default": 0 },
          "language": { "type": "string", "default": "en" },
          "domains_allow": { "type": "array" },
          "domains_deny": { "type": "array" },
          "location": { "type": "object" }
        },
        "additionalProperties": true
      },
      "side_effect": "none"
    }
  ],
  "retrieval_profile": {
    "enabled": true,
    "roles": ["search"],
    "domains": ["web", "archives"],
    "entity_types": ["url", "snapshot"],
    "freshness": { "type": "batch", "sla_hours": 168 },
    "quality": {
      "default_confidence": 0.56,
      "trust_tier": "community",
      "citation_mode": "url_required"
    },
    "cost": {
      "latency_class": "medium",
      "quota_class": "free"
    },
    "setup": {
      "requires_auth": false,
      "required_fields": [],
      "healthcheck_action": "commoncrawl.search.query"
    },
    "output_contract": {
      "evidence_schema": "external.evidence.v1"
    },
    "routing_hints": {
      "preferred_intents": ["general_knowledge", "latest_update"],
      "avoid_when": ["music_lookup", "media_lookup"]
    }
  },
  "auth": {
    "mode": "none",
    "required": false,
    "fields": []
  }
}
