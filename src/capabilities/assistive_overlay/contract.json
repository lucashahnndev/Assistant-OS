{
    "contract_version": "1.0",
    "capability": {
        "id": "assistive_overlay",
        "namespace": "overlay.assist",
        "version": "1.0.0",
        "title": "overlay.assist",
        "description": "Overlay assistivo global para destacar elementos na tela sem bloquear mouse/teclado.",
        "assets": {
            "icon_svg": "assets/icon.svg"
        }
    },
    "runtime": {
        "module": "capabilities.assistive_overlay",
        "factory": "create_capability",
        "config_schema": "./config.schema.json"
    },
    "actions": [
        {
            "id": "overlay.assist.highlight_target",
            "title": "Highlight Target",
            "description": "Localiza um elemento na tela via vis\u00e3o e desenha marca\u00e7\u00e3o tempor\u00e1ria.",
            "handler": "highlight_target",
            "risk_level": "low",
            "permissions": {
                "scopes": [
                    "overlay:assist:highlight_target"
                ],
                "allow_anyone": true,
                "requires_approval": false
            },
            "parameters": {
                "type": "object",
                "properties": {
                    "label": {
                        "type": "string",
                        "description": "Descri\u00e7\u00e3o do alvo na tela."
                    },
                    "target": {
                        "type": "string",
                        "description": "Alias de label."
                    },
                    "query": {
                        "type": "string",
                        "description": "Alias de label."
                    },
                    "hint": {
                        "type": "string",
                        "description": "Dica extra para o locator."
                    },
                    "mark_type": {
                        "type": "string",
                        "enum": [
                            "focus_corners",
                            "circle",
                            "rect",
                            "arrow",
                            "line",
                            "text",
                            "path",
                            "draw_focus_corners",
                            "draw_circle",
                            "draw_rect",
                            "draw_arrow",
                            "draw_line",
                            "draw_text",
                            "draw_path"
                        ],
                        "default": "focus_corners"
                    },
                    "color": {
                        "type": "string",
                        "default": "#00E5FF"
                    },
                    "stroke_width": {
                        "type": "integer",
                        "default": 3
                    },
                    "opacity": {
                        "type": "number",
                        "default": 0.95
                    },
                    "ttl_ms": {
                        "type": "integer",
                        "default": 2200
                    },
                    "pulse": {
                        "type": "boolean",
                        "default": true
                    },
                    "screen_id": {
                        "type": "integer"
                    }
                },
                "additionalProperties": true
            },
            "side_effect": "none"
        },
        {
