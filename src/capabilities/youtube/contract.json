{
  "contract_version": "1.0",
  "capability": {
    "id": "youtube",
    "namespace": "youtube",
    "version": "1.0.0",
    "title": "youtube",
    "description": "Domínio YouTube unificado: busca, metadados e transcript opcional para RAG externo.",
    "assets": {
      "icon_svg": "assets/icon.svg"
    }
  },
  "runtime": {
    "module": "capabilities.youtube",
    "factory": "create_capability",
    "config_schema": "./config.schema.json"
  },
  "actions": [
    {
      "id": "youtube.search.find",
      "title": "Find",
      "description": "Encontra vídeos, playlists e canais no YouTube.",
      "handler": "search.find",
      "risk_level": "low",
      "permissions": {
        "scopes": [
          "youtube:search:find"
        ],
        "allow_anyone": true,
        "requires_approval": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "video",
              "playlist",
              "channel"
            ],
            "default": "video"
          },
          "limit": {
            "type": "integer",
            "default": 5
          }
        },
        "additionalProperties": true
      },
      "side_effect": "none"
    },
    {
      "id": "youtube.retrieve.get",
      "title": "Get",
      "description": "Obtém metadados de vídeo e transcript opcional.",
      "handler": "retrieve.get",
      "risk_level": "low",
      "permissions": {
        "scopes": [
          "youtube:retrieve:get"
        ],
        "allow_anyone": true,
        "requires_approval": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "video_id": {
            "type": "string"
          },
          "include_transcript": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": true
      },
      "side_effect": "none"
    }
  ],
  "retrieval_profile": {
    "enabled": true,
    "roles": [
      "search",
      "retrieve",
      "metadata_only"
    ],
    "domains": [
      "music",
      "media",
      "web"
    ],
    "entity_types": [
      "video",
      "playlist",
      "channel"
    ],
    "freshness": {
      "type": "live",
      "sla_hours": 12
    },
    "quality": {
      "default_confidence": 0.7,
      "trust_tier": "public_api",
      "citation_mode": "url_required"
    },
    "cost": {
      "latency_class": "medium",
      "quota_class": "metered"
    },
    "setup": {
      "requires_auth": false,
      "required_fields": [],
      "healthcheck_action": "youtube.search.find"
    },
    "output_contract": {
      "evidence_schema": "external.evidence.v1",
      "entity_schema": "external.entity.v1"
    },
    "routing_hints": {
      "preferred_intents": [
        "music_lookup",
        "media_lookup"
      ],
      "avoid_when": [
        "policy_lookup"
      ]
    }
  },
  "auth": {
    "mode": "hybrid",
    "required": false,
    "source_config_path": "authSource",
    "default_source": "auto",
    "sources": [
      {
        "id": "auto",
        "type": "strategy",
        "title": "Automatic",
        "description": "Prefer linked Google account and fallback to API key when available."
      },
      {
        "id": "linked_account",
        "type": "oauth_account",
        "title": "Linked Google Account Only",
        "description": "Use only a connected Google account for this capability.",
        "provider": "google"
      },
      {
        "id": "api_key",
        "type": "secret_ref",
        "title": "API Key Only",
        "description": "Use only the configured API key for this capability.",
        "field_id": "apikey"
      }
    ],
    "fields": [
      {
        "id": "apikey",
        "type": "secret_ref",
        "config_path": "apiKey",
        "required": false,
        "title": "YouTube Data API Key",
        "secret_policy": {
          "allow_create": true,
          "allow_select": true
        }
      }
    ]
  },
  "discoverability_profile": {
    "enabled": true,
    "roles": [
      "search",
      "retrieve",
      "metadata_only"
    ],
    "domains": [
      "music",
      "media",
      "web"
    ],
    "entity_types": [
      "video",
      "playlist",
      "channel"
    ],
    "keywords": [
      "youtube",
      "dominio",
      "unificado",
      "busca",
      "metadados",
      "transcript",
      "opcional",
      "para",
      "rag",
      "externo",
      "discover",
      "consult",
      "discoverability",
      "search",
      "retrieve",
      "control",
      "interact",
      "manage",
      "open",
      "close"
    ],
    "routing_hints": {
      "preferred_intents": [
        "music_lookup",
        "media_lookup"
      ],
      "avoid_when": [
        "policy_lookup"
      ]
    }
  }
}
