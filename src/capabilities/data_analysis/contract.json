{
    "contract_version": "1.0",
    "capability": {
        "id": "data_analysis",
        "namespace": "data.analysis",
        "version": "1.0.0",
        "title": "data.analysis",
        "description": "Analisa dados tabulares/s\u00e9ries num\u00e9ricas e gera resumo, estat\u00edsticas e tabela markdown para visualiza\u00e7\u00e3o em cards.",
        "assets": {
            "icon_svg": "assets/icon.svg"
        }
    },
    "runtime": {
        "module": "capabilities.data_analysis",
        "factory": "create_capability",
        "config_schema": "./config.schema.json"
    },
    "actions": [
        {
            "id": "data.analysis.summarize",
            "title": "Summarize",
            "description": "Gera resumo estat\u00edstico e tabela markdown de uma s\u00e9rie num\u00e9rica.",
            "handler": "summarize",
            "risk_level": "low",
            "permissions": {
                "scopes": [
                    "data:analysis:summarize"
                ],
                "allow_anyone": true,
                "requires_approval": false
            },
            "parameters": {
                "type": "object",
                "properties": {
                    "rows": {
                        "type": "array",
                        "description": "Lista de registros (objetos) com campos para eixo X e Y."
                    },
                    "x_key": {
                        "type": "string",
                        "description": "Nome da coluna X (categoria/tempo)."
                    },
                    "y_key": {
                        "type": "string",
                        "description": "Nome da coluna Y (valor num\u00e9rico)."
                    },
                    "labels": {
                        "type": "array",
                        "description": "Labels para s\u00e9rie quando rows n\u00e3o for usado."
                    },
                    "values": {
                        "type": "array",
                        "description": "Valores num\u00e9ricos da s\u00e9rie quando rows n\u00e3o for usado."
                    },
                    "title": {
                        "type": "string",
                        "description": "T\u00edtulo opcional para o conjunto analisado."
                    },
                    "max_points": {
                        "type": "integer",
                        "description": "Limite m\u00e1ximo de pontos processados.",
                        "default": 24
                    }
                },
                "additionalProperties": true
            },
            "side_effect": "none"
        }
    ],
    "auth": {
        "mode": "none",
        "required": false,
        "fields": []
    }
}