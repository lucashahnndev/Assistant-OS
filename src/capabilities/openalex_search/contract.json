{
  "contract_version": "1.0",
  "capability": {
    "id": "openalex_search",
    "namespace": "openalex.search",
    "version": "1.0.0",
    "title": "openalex.search",
    "description": "Busca acadêmica via OpenAlex para RAG externo.",
    "assets": {
      "icon_svg": "assets/icon.svg"
    }
  },
  "runtime": {
    "module": "capabilities.openalex_search",
    "factory": "create_capability",
    "config_schema": "./config.schema.json"
  },
  "actions": [
    {
      "id": "openalex.search.query",
      "title": "Query",
      "description": "Executa busca acadêmica no provider OpenAlex.",
      "handler": "query",
      "risk_level": "low",
      "permissions": {
        "scopes": [
          "openalex:search:query"
        ],
        "allow_anyone": true,
        "requires_approval": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 6
          },
          "recency_days": {
            "type": "integer",
            "default": 0
          },
          "language": {
            "type": "string",
            "default": "en"
          },
          "domains_allow": {
            "type": "array"
          },
          "domains_deny": {
            "type": "array"
          },
          "location": {
            "type": "object"
          }
        },
        "additionalProperties": true
      },
      "side_effect": "none"
    }
  ],
  "retrieval_profile": {
    "enabled": true,
    "roles": [
      "search",
      "structured_entity"
    ],
    "domains": [
      "academic",
      "papers"
    ],
    "entity_types": [
      "paper",
      "study",
      "author"
    ],
    "freshness": {
      "type": "live",
      "sla_hours": 24
    },
    "quality": {
      "default_confidence": 0.78,
      "trust_tier": "public_api",
      "citation_mode": "url_required"
    },
    "cost": {
      "latency_class": "medium",
      "quota_class": "free"
    },
    "setup": {
      "requires_auth": false,
      "required_fields": [],
      "healthcheck_action": "openalex.search.query"
    },
    "output_contract": {
      "evidence_schema": "external.evidence.v1",
      "entity_schema": "external.entity.v1"
    },
    "routing_hints": {
      "preferred_intents": [
        "academic_lookup",
        "structured_fact"
      ],
      "avoid_when": [
        "music_lookup",
        "media_lookup"
      ]
    }
  },
  "auth": {
    "mode": "none",
    "required": false,
    "fields": []
  },
  "discoverability_profile": {
    "enabled": true,
    "roles": [
      "search",
      "structured_entity"
    ],
    "domains": [
      "academic",
      "papers"
    ],
    "entity_types": [
      "paper",
      "study",
      "author"
    ],
    "keywords": [
      "openalex_search",
      "openalex",
      "search",
      "busca",
      "academica",
      "via",
      "para",
      "rag",
      "externo",
      "discover",
      "consult",
      "discoverability",
      "retrieve",
      "control",
      "interact",
      "manage",
      "open",
      "close",
      "read",
      "write"
    ],
    "routing_hints": {
      "preferred_intents": [
        "academic_lookup",
        "structured_fact"
      ],
      "avoid_when": [
        "music_lookup",
        "media_lookup"
      ]
    }
  }
}
