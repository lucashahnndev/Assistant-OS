{
    "contract_version": "1.0",
    "capability": {
        "id": "memory_management",
        "namespace": "memory",
        "version": "1.0.0",
        "title": "Memory",
        "description": "Mem\u00f3ria persistente do agente para armazenar e recuperar fatos relevantes do usu\u00e1rio e do contexto.",
        "assets": {
            "icon_svg": "assets/icon.svg"
        }
    },
    "runtime": {
        "module": "capabilities.memory_management",
        "factory": "create_capability"
    },
    "actions": [
        {
            "id": "memory.recall",
            "title": "Recall",
            "description": "Busca informa\u00e7\u00f5es j\u00e1 registradas na mem\u00f3ria persistente.",
            "handler": "recall",
            "risk_level": "low",
            "permissions": {
