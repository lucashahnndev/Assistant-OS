{
  "provider": "openai",
  "display_name": "OpenAI",
  "supports": [
    "chat",
    "stt"
  ],
  "defaults": {
    "model": "gpt-4o-mini",
    "timeout": 90,
    "max_tokens": 1024
  },
  "models": [
    "gpt-4o",
    "gpt-4o-mini",
    "gpt-3.5-turbo",
    "whisper-1"
  ],
  "auth": {
    "mode": "api_key",
    "fields": [
      {
        "key": "secret_ref",
        "type": "secret_ref",
        "title": "API Key",
        "required": true,
        "description": "",
        "placeholder": ""
      }
    ]
  },
  "settings_fields": [
    {
      "key": "base_url",
      "type": "string",
      "title": "Base URL override",
      "required": false,
      "description": "Optional local or proxy endpoint. Leave empty to use the default OpenAI API.",
      "placeholder": "http://127.0.0.1:8009/v1"
    },
    {
      "key": "organization_id",
      "type": "secret_ref",
      "title": "Organization ID",
      "required": false,
      "description": "",
      "placeholder": "ENV_OPENAI_ORG_ID"
    },
    {
      "key": "model",
      "type": "string",
      "title": "Model Name",
      "required": true,
      "description": "",
      "placeholder": ""
    }
  ]
}
