{
  "provider": "google_cloud",
  "display_name": "Google Cloud TTS",
  "supports": [
    "tts"
  ],
  "defaults": {},
  "models": [],
  "auth": {
    "mode": "api_key",
    "fields": [
      {
        "key": "secret_ref",
        "type": "secret_ref",
        "title": "Google Cloud API Key",
        "required": true,
        "description": "",
        "placeholder": ""
      }
    ]
  },
  "settings_fields": [
    {
      "key": "language",
      "type": "string",
      "title": "Language Code",
      "required": false,
      "default": "pt-BR"
    },
    {
      "key": "voice_name",
      "type": "string",
      "title": "Voice Name",
      "required": false,
      "default": "pt-BR-Neural2-B"
    },
    {
      "key": "ssml_gender",
      "type": "string",
      "title": "Gender (MALE, FEMALE, NEUTRAL)",
      "required": false,
      "default": "MALE"
    }
  ]
}
