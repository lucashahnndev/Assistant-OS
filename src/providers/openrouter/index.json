{
    "provider": "openrouter",
    "display_name": "OpenRouter",
    "supports": [
        "chat",
        "vision"
    ],
    "defaults": {
        "model": "arcee-ai/trinity-large-preview:free",
        "timeout": 90,
        "max_tokens": 1024
    },
    "fields": [
        {
            "name": "api_key_ref",
            "type": "env_ref",
            "label": "API Key",
            "required": true
        },
        {
            "name": "model",
            "type": "string",
            "label": "Model ID",
            "required": true
        },
        {
            "name": "max_tokens",
            "type": "number",
            "label": "Max Tokens",
            "required": false
        }
    ],
    "models": [
        "arcee-ai/trinity-large-preview:free",
        "google/gemma-3-4b-it:free",
        "openai/gpt-3.5-turbo",
        "anthropic/claude-3-haiku"
    ]
}