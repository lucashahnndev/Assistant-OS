{
  "provider": "local_qwen",
  "display_name": "Local Qwen Server",
  "supports": [
    "chat",
    "vision"
  ],
  "defaults": {
    "base_url": "http://127.0.0.1:9000/v1",
    "model": "Qwen/Qwen2.5-VL-3B-Instruct",
    "timeout": 30,
    "max_tokens": 512
  },
  "models": [
    "Qwen/Qwen2.5-VL-3B-Instruct",
    "Qwen/Qwen2.5-VL-7B-Instruct"
  ],
  "auth": {
    "mode": "none",
    "fields": []
  },
  "settings_fields": [
    {
      "key": "base_url",
      "type": "string",
      "title": "Base URL",
      "required": true,
      "description": "",
      "placeholder": ""
    },
    {
      "key": "model",
      "type": "string",
      "title": "Model Name",
      "required": true,
      "description": "",
      "placeholder": ""
    },
    {
      "key": "timeout",
      "type": "number",
      "title": "Timeout (s)",
      "required": false,
      "description": "",
      "placeholder": ""
    },
    {
      "key": "max_tokens",
      "type": "number",
      "title": "Max Tokens",
      "required": false,
      "description": "",
      "placeholder": ""
    }
  ]
}
